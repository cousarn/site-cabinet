# Points d'entrée PHP : contact, saisine, devis, consultation, jeton (anti-robot), depot, depot-admin, pre-entretien, paypal-ipn. Bibliothèques (_*.php) et configuration interdites.
<FilesMatch "^(_.*|config\.local|config)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(log|json|txt|md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/api/\.cache(/|$)
Options -Indexes
