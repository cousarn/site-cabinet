---
/**
 * Bandeau d'accueil — quatre compositions autour du portrait de Me Cousin (photo David Ferrière, jamais retouchée,
 * jamais recouverte : aucun texte ni pastille sur la photo). Le couloir du cabinet sert de fond en filigrane.
 *   a — « Fondu »     : portrait pleine hauteur à droite, bord gauche fondu dans le papier, texte à gauche.
 *   b — « Débord »    : portrait carré non recadré, filet laiton décalé, qui déborde sur la section suivante ; nom géant derrière.
 *   c — « Bande verte » : bandeau vert de la charte, portrait pleine hauteur bord à bord à droite, couloir en texture sur le vert.
 *   d — « Éditorial » : grand titre sur toute la largeur, puis portrait carré à gauche et texte à droite.
 */
import { Image } from 'astro:assets';
import { cabinet, anneesExercice, anneesEnLettres } from '../data/cabinet';
import portrait from '../assets/photos/portrait-arnaud-cousin-2000.webp';
import couloir from '../assets/photos/couloir-fond-1600x900.webp'; // couloir sans la silhouette : un seul Arnaud par bandeau

interface Props { variante: 'a' | 'b' | 'c' | 'd' }
const { variante } = Astro.props;
const n = anneesExercice();
const alt = 'Maître Arnaud Cousin, avocat au Barreau de Rennes';
---
<section class={`ha ha--${variante}`}>
  <div class="ha-fond" aria-hidden="true">
    <Image src={couloir} alt="" widths={[900, 1300, 1600]} sizes="100vw" quality={55} loading="eager" />
  </div>
  {variante === 'b' && <div class="ha-nom" aria-hidden="true"><span>Arnaud</span><span>Cousin</span></div>}

  {variante === 'a' && (
    <>
      <div class="ha-a__photo"><Image src={portrait} alt={alt} widths={[700, 1000, 1400, 2000]} sizes="(max-width: 860px) 100vw, 52vw" quality={82} loading="eager" fetchpriority="high" /></div>
      <div class="conteneur ha-a__grille">
        <div class="ha-texte pile entree">
          <p class="surtitre ha-surtitre"><span class="filet"></span>Famille · Successions · Travail · Procédure civile</p>
          <h1>Écouter. Analyser.<br />Conseiller. <em>Agir.</em></h1>
          <p class="chapo">Séparation, succession bloquée, licenciement : vous devez savoir vite où vous en êtes, et à quel prix. Négociateur pugnace ou défenseur combatif, avocat à Rennes depuis {anneesEnLettres(n)} ans : appui, soutien et conseil, à des conditions transparentes.</p>
          <div class="ha-boutons"><a href="/services/rendez-vous" class="btn btn--plein btn--grand">Prendre rendez-vous</a><a href="/services/consultation-ecrite" class="btn btn--contour btn--grand">Consultation écrite en ligne</a></div>
          <p class="ha-urgence">Urgence, délai qui expire : <a href={`tel:${cabinet.telephoneE164}`}>{cabinet.telephone}</a> — prise de message 24h/24.</p>
        </div>
      </div>
    </>
  )}

  {variante === 'b' && (
    <div class="conteneur ha-b__grille">
      <div class="ha-texte pile entree">
        <p class="surtitre ha-surtitre"><span class="filet"></span>Famille · Successions · Travail · Procédure civile</p>
        <h1>Écouter. Analyser.<br />Conseiller. <em>Agir.</em></h1>
        <p class="chapo">Séparation, succession bloquée, licenciement : vous devez savoir vite où vous en êtes, et à quel prix. Négociateur pugnace ou défenseur combatif, avocat à Rennes depuis {anneesEnLettres(n)} ans : appui, soutien et conseil, à des conditions transparentes.</p>
        <div class="ha-boutons"><a href="/services/rendez-vous" class="btn btn--plein btn--grand">Prendre rendez-vous</a><a href="/services/consultation-ecrite" class="btn btn--contour btn--grand">Consultation écrite en ligne</a></div>
        <p class="ha-urgence">Urgence, délai qui expire : <a href={`tel:${cabinet.telephoneE164}`}>{cabinet.telephone}</a> — prise de message 24h/24.</p>
      </div>
      <figure class="ha-b__photo figure"><span class="cadre"><Image src={portrait} alt={alt} widths={[600, 900, 1200]} sizes="(max-width: 860px) 86vw, 460px" quality={82} loading="eager" fetchpriority="high" /></span></figure>
    </div>
  )}

  {variante === 'c' && (
    <>
      <div class="ha-c__photo"><Image src={portrait} alt={alt} widths={[700, 1000, 1400, 2000]} sizes="(max-width: 860px) 100vw, 44vw" quality={82} loading="eager" fetchpriority="high" /></div>
      <div class="conteneur ha-c__grille">
        <div class="ha-texte pile entree">
          <p class="surtitre ha-surtitre"><span class="filet"></span>Famille · Successions · Travail · Procédure civile</p>
          <h1>Écouter. Analyser.<br />Conseiller. <em>Agir.</em></h1>
          <p class="chapo">Séparation, succession bloquée, licenciement : vous devez savoir vite où vous en êtes, et à quel prix. Négociateur pugnace ou défenseur combatif, avocat à Rennes depuis {anneesEnLettres(n)} ans : appui, soutien et conseil, à des conditions transparentes.</p>
          <div class="ha-boutons"><a href="/services/rendez-vous" class="btn btn--clair btn--grand">Prendre rendez-vous</a><a href="/services/consultation-ecrite" class="btn btn--contour-clair btn--grand">Consultation écrite en ligne</a></div>
          <p class="ha-urgence">Urgence, délai qui expire : <a href={`tel:${cabinet.telephoneE164}`}>{cabinet.telephone}</a> — prise de message 24h/24.</p>
        </div>
      </div>
    </>
  )}

  {variante === 'd' && (
    <div class="conteneur ha-d__grille">
      <h1 class="ha-d__titre entree">Écouter. Analyser.<br />Conseiller. <em>Agir.</em></h1>
      <figure class="ha-d__photo figure"><span class="cadre"><Image src={portrait} alt={alt} widths={[600, 900, 1200]} sizes="(max-width: 860px) 86vw, 520px" quality={82} loading="eager" fetchpriority="high" /></span></figure>
      <div class="ha-texte ha-d__texte pile entree">
        <p class="surtitre ha-surtitre"><span class="filet"></span>Famille · Successions · Travail · Procédure civile</p>
        <p class="chapo">Séparation, succession bloquée, licenciement : vous devez savoir vite où vous en êtes, et à quel prix. Négociateur pugnace ou défenseur combatif, avocat à Rennes depuis {anneesEnLettres(n)} ans : appui, soutien et conseil, à des conditions transparentes.</p>
        <div class="ha-boutons"><a href="/services/rendez-vous" class="btn btn--plein btn--grand">Prendre rendez-vous</a><a href="/services/consultation-ecrite" class="btn btn--contour btn--grand">Consultation écrite en ligne</a></div>
        <p class="ha-urgence">Urgence, délai qui expire : <a href={`tel:${cabinet.telephoneE164}`}>{cabinet.telephone}</a> — prise de message 24h/24.</p>
        <dl class="ha-d__reperes">
          <div><dt>{n} ans</dt><dd>de barreau à Rennes</dd></div>
          <div><dt>Amiable</dt><dd>médiation, conciliation, accords</dd></div>
          <div><dt>Cour d’appel</dt><dd>à 400 m, postulation pour les confrères</dd></div>
        </dl>
      </div>
    </div>
  )}
</section>

<style>
  /* ---- Commun -------------------------------------------------------------------- */
  .ha { position: relative; overflow: hidden; background: var(--papier); color: var(--encre); border-top: 1px solid var(--ligne-douce); }
  .ha-fond { position: absolute; inset: 0; pointer-events: none; }
  .ha-fond img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%; opacity: .26; filter: grayscale(.45) contrast(1.05); mix-blend-mode: multiply; }
  .ha-texte { gap: 26px; max-width: 600px; position: relative; }
  .ha-surtitre { display: flex; align-items: center; gap: 14px; }
  .ha h1 { font-size: clamp(42px, 5.4vw, 70px); }
  .ha h1 em { font-style: italic; color: var(--laiton-sombre); }
  .ha .chapo { font-size: 19px; }
  .ha-boutons { display: flex; flex-wrap: wrap; gap: 14px; }
  .ha-urgence { font-size: 14px; color: var(--muet); }
  .ha-urgence a { color: var(--vert); font-weight: 600; text-decoration: none; }

  /* ---- A : fondu ------------------------------------------------------------------ */
  .ha--a .ha-fond img { -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 40%, transparent 62%); mask-image: linear-gradient(90deg, #000 0%, #000 40%, transparent 62%); }
  .ha-a__photo { position: absolute; top: 0; bottom: 0; right: 0; width: 54%; }
  .ha-a__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; display: block;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 34%, #000 100%); mask-image: linear-gradient(90deg, transparent 0%, #000 34%, #000 100%); }
  .ha-a__grille { position: relative; min-height: 680px; display: flex; align-items: center; padding-top: 72px; padding-bottom: 72px; }
  .ha--a .ha-texte { max-width: 560px; }

  /* ---- B : débord ----------------------------------------------------------------- */
  .ha--b { overflow: visible; z-index: 2; }
  .ha--b .ha-fond { overflow: hidden; }
  .ha--b .ha-fond img { opacity: .22; -webkit-mask-image: linear-gradient(0deg, transparent 0%, #000 30%); mask-image: linear-gradient(0deg, transparent 0%, #000 30%); }
  .ha-nom { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; pointer-events: none; font-family: var(--serif); font-weight: 300; font-size: clamp(110px, 17vw, 260px); line-height: .8; letter-spacing: -.04em; color: var(--laiton); opacity: .13; }
  .ha-nom span { position: absolute; left: max(24px, calc((100% - var(--conteneur)) / 2 - 8px)); white-space: nowrap; }
  .ha-nom span:first-child { top: 26px; }
  .ha-nom span:last-child { bottom: 24px; font-style: italic; left: 44%; }
  .ha-b__grille { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 460px); gap: 56px; align-items: center; padding-top: 80px; padding-bottom: 40px; }
  .ha-b__photo { justify-self: end; width: min(100%, 460px); margin-bottom: -96px; }
  .ha-b__photo .cadre::before { inset: 18px -18px -18px 18px; }
  .ha-b__photo img { aspect-ratio: 1 / 1; border-radius: 4px; box-shadow: 0 40px 70px -40px rgba(17, 53, 47, .5); }

  /* ---- C : bande verte ------------------------------------------------------------ */
  .ha--c { background: var(--vert); color: var(--sur-vert); border-top: 0; }
  .ha--c .ha-fond img { opacity: .34; filter: grayscale(1) contrast(1.15); mix-blend-mode: luminosity; object-position: 40% 50%; -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 45%, transparent 58%); mask-image: linear-gradient(90deg, #000 0%, #000 45%, transparent 58%); }
  .ha--c::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(17, 53, 47, 0) 0%, rgba(17, 53, 47, .35) 100%); pointer-events: none; }
  .ha-c__photo { position: absolute; top: 0; bottom: 0; right: 0; width: 44%; border-left: 1px solid rgba(202, 171, 127, .55); }
  .ha-c__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; display: block; }
  .ha-c__grille { position: relative; min-height: 680px; display: flex; align-items: center; padding-top: 72px; padding-bottom: 72px; }
  .ha--c .ha-texte { max-width: 540px; }
  .ha--c h1 { color: var(--sur-vert); }
  .ha--c h1 em { color: var(--laiton-clair); }
  .ha--c .surtitre { color: var(--laiton-clair); }
  .ha--c .filet { background: var(--laiton-clair); }
  .ha--c .chapo { color: #D8DDD6; }
  .ha--c .ha-urgence { color: var(--sur-vert-muet); }
  .ha--c .ha-urgence a { color: #E9D9B5; }

  /* ---- D : éditorial -------------------------------------------------------------- */
  .ha--d .ha-fond img { opacity: .2; object-position: 50% 40%; -webkit-mask-image: linear-gradient(0deg, transparent 0%, #000 40%); mask-image: linear-gradient(0deg, transparent 0%, #000 40%); }
  .ha-d__grille { position: relative; display: grid; grid-template-columns: minmax(280px, 520px) minmax(0, 1fr); grid-template-areas: 'titre titre' 'photo texte'; column-gap: 64px; row-gap: 48px; padding-top: 64px; padding-bottom: 80px; align-items: center; }
  .ha-d__titre { grid-area: titre; font-size: clamp(46px, 7.4vw, 108px); line-height: .98; letter-spacing: -.025em; max-width: 1100px; }
  .ha-d__photo { grid-area: photo; width: 100%; }
  .ha-d__photo img { aspect-ratio: 1 / 1; border-radius: 4px; }
  .ha-d__texte { grid-area: texte; max-width: 560px; }
  .ha-d__reperes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 14px 0 0; padding-top: 22px; border-top: 1px solid var(--laiton); }
  .ha-d__reperes dt { font-family: var(--serif); font-size: 26px; color: var(--vert); line-height: 1.1; }
  .ha-d__reperes dd { margin: 4px 0 0; font-size: 13px; color: var(--muet); }

  /* ---- Mobile --------------------------------------------------------------------- */
  @media (max-width: 860px) {
    .ha h1 { font-size: clamp(38px, 10.5vw, 48px); }
    .ha-fond img { opacity: .18; }
    .ha-a__photo { position: relative; width: 100%; height: 100vw; max-height: 540px; }
    .ha-a__photo img { object-position: 50% 30%; -webkit-mask-image: linear-gradient(0deg, transparent 0%, #000 26%, #000 100%); mask-image: linear-gradient(0deg, transparent 0%, #000 26%, #000 100%); }
    .ha-a__grille { min-height: 0; padding-top: 8px; padding-bottom: 48px; }
    .ha-b__grille { grid-template-columns: 1fr; gap: 36px; padding-top: 32px; padding-bottom: 32px; }
    .ha-b__photo { order: -1; justify-self: center; width: min(86vw, 420px); margin-bottom: 0; }
    .ha-nom { font-size: clamp(90px, 24vw, 150px); }
    .ha-nom span:last-child { left: 22%; bottom: auto; top: 24vw; }
    .ha-c__photo { position: relative; width: 100%; height: 100vw; max-height: 520px; border-left: 0; border-bottom: 1px solid rgba(202, 171, 127, .55); }
    .ha-c__grille { min-height: 0; padding-top: 40px; padding-bottom: 48px; }
    .ha-d__grille { grid-template-columns: 1fr; grid-template-areas: 'titre' 'photo' 'texte'; row-gap: 32px; padding-top: 40px; padding-bottom: 48px; }
    .ha-d__titre { font-size: clamp(40px, 11vw, 60px); }
    .ha-d__photo { width: min(86vw, 420px); justify-self: center; }
    .ha-d__reperes { grid-template-columns: 1fr 1fr; }
  }
</style>
