---
import { cabinet, navigation } from '../data/cabinet';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const estCourant = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/') || (href === '/services' && path.startsWith('/services')) || (href === '/fiches' && path.startsWith('/fiches')) || (href === '/domaines' && path.startsWith('/domaines'));

const chevron = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>`;
const fleche = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;
---

<div class="barre-info">
  <div class="conteneur barre-info__in">
    <div class="barre-info__gauche">
      <span>{cabinet.adresse.rue}, {cabinet.adresse.cp} {cabinet.adresse.ville}</span>
      <span class="barre-info__horaires">{cabinet.horaires}</span>
      <a href={`tel:${cabinet.telephoneE164}`}>{cabinet.telephone}</a>
    </div>
    <a href="/notaires-confreres" class="barre-info__pro">Espace notaires &amp; confrères →</a>
  </div>
</div>

<header class="en-tete" id="en-tete">
  <div class="conteneur en-tete__in">
    <a href="/" class="marque" title="Accueil">
      <span class="marque__nom">Arnaud Cousin</span>
      <span class="marque__sous">Avocat au {cabinet.barreau}</span>
    </a>

    <button type="button" class="burger" aria-label="Menu" aria-expanded="false" aria-controls="menu-mobile">
      <span class="burger__trait"></span><span class="burger__trait"></span><span class="burger__trait"></span>
    </button>

    <nav class="nav" aria-label="Navigation principale" id="menu-mobile">
      {navigation.principale.map((item) => (
        'menu' in item && item.menu ? (
          <div class="nav__groupe">
            <a href={item.href} aria-current={estCourant(item.href) ? 'page' : undefined} aria-haspopup="true" aria-expanded="false">{item.label} <Fragment set:html={chevron} /></a>
            <button type="button" class="nav__ouvrir" aria-label={`Ouvrir le sous-menu ${item.label}`} aria-expanded="false"><Fragment set:html={chevron} /></button>
            <div class={`mega ${item.menu === 'services' ? 'mega--3' : ''}`} role="group" aria-label={item.label}>
              {(item.menu === 'domaines' ? navigation.domaines : navigation.services).map((e) => (
                <a href={e.href}><span class="mega__titre">{e.titre} <Fragment set:html={fleche} /></span><span class="mega__texte">{e.accroche}</span></a>
              ))}
              {item.menu === 'domaines' ? (
                <div class="mega__pied"><span>Votre situation n’entre dans aucune case ? Décrivez-la.</span><span><a href="/services#assistant">Préparer mon rendez-vous →</a> &nbsp;·&nbsp; <a href="/domaines">Tous les domaines →</a></span></div>
              ) : (
                <div class="mega__pied"><span>Une urgence, un délai qui expire ? Appelez le <strong>{cabinet.telephone}</strong> — prise de message 24h/24.</span><a href="/services">Tous les services en ligne →</a></div>
              )}
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={estCourant(item.href) ? 'page' : undefined}>{item.label}</a>
        )
      ))}
      <a href="/services/rendez-vous" class="btn btn--plein nav__cta nav__cta--mobile">Prendre rendez-vous</a>
    </nav>

    <a href="/services/rendez-vous" class="btn btn--plein nav__cta nav__cta--bureau">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
      Rendez-vous
    </a>
  </div>
</header>

<style>
  .barre-info { background: var(--vert-nuit); color: var(--sur-vert-muet); font-size: 13px; }
  .barre-info__in { padding-top: 8px; padding-bottom: 8px; display: flex; flex-wrap: wrap; gap: 8px 28px; justify-content: space-between; align-items: center; }
  .barre-info__gauche { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .barre-info a { color: #E9D9B5; text-decoration: none; font-weight: 600; }
  .barre-info a:hover { color: #fff; }
  @media (max-width: 720px) { .barre-info__horaires, .barre-info__pro { display: none; } }

  .en-tete { position: sticky; top: 0; z-index: 50; background: rgba(244, 239, 230, .9); -webkit-backdrop-filter: saturate(1.2) blur(12px); backdrop-filter: saturate(1.2) blur(12px); border-bottom: 1px solid var(--ligne); transition: box-shadow .3s ease, background-color .3s ease; }
  .en-tete.est-compact { box-shadow: 0 10px 30px rgba(23, 26, 24, .08); background: rgba(244, 239, 230, .96); }
  .en-tete__in { position: relative; padding-top: 18px; padding-bottom: 18px; display: flex; flex-wrap: nowrap; gap: 12px 20px; align-items: center; justify-content: space-between; transition: padding .3s ease; }
  .est-compact .en-tete__in { padding-top: 9px; padding-bottom: 9px; }

  .marque { text-decoration: none; color: var(--encre); display: flex; flex-direction: column; line-height: 1.1; }
  .marque__nom { font-family: var(--serif); font-size: 26px; font-weight: 500; letter-spacing: -.01em; transition: font-size .3s ease; }
  .marque__sous { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--laiton-sombre); margin-top: 6px; max-height: 20px; overflow: hidden; transition: max-height .3s ease, opacity .3s ease, margin-top .3s ease; }
  .est-compact .marque__nom { font-size: 22px; }
  .est-compact .marque__sous { max-height: 0; opacity: 0; margin-top: 0; }

  .nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0; font-size: 14.5px; }
  .nav > a, .nav__groupe > a { position: relative; display: inline-flex; align-items: center; gap: 6px; padding: 10px 10px; border-radius: var(--r); color: var(--encre); text-decoration: none; font-weight: 500; transition: color .2s ease; }
  .nav > a::after, .nav__groupe > a::after { content: ''; position: absolute; left: 10px; right: 10px; bottom: 5px; height: 1px; background: var(--laiton); transform: scaleX(0); transform-origin: right; transition: transform .32s cubic-bezier(.4, 0, .2, 1); }
  .nav > a:hover, .nav__groupe > a:hover, .nav > a:focus-visible, .nav__groupe:focus-within > a, .nav__groupe:hover > a, .nav a[aria-current=page] { color: var(--laiton-sombre); }
  .nav > a:hover::after, .nav__groupe:hover > a::after, .nav__groupe:focus-within > a::after, .nav > a:focus-visible::after, .nav a[aria-current=page]::after, .nav__groupe.est-ouvert > a::after { transform: scaleX(1); transform-origin: left; }
  .nav__groupe > a svg { transition: transform .25s ease; }
  .nav__groupe:hover > a svg, .nav__groupe:focus-within > a svg, .nav__groupe.est-ouvert > a svg { transform: rotate(180deg); }
  .nav__ouvrir { display: none; }

  .mega { position: absolute; top: calc(100% - 1px); left: 24px; right: 24px; z-index: 60; background: var(--ivoire); border: 1px solid var(--ligne); border-top: 2px solid var(--laiton); border-radius: 0 0 var(--r) var(--r); box-shadow: 0 30px 70px rgba(13, 38, 34, .18); padding: 22px 22px 18px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px 18px; opacity: 0; visibility: hidden; transform: translateY(10px); transition: opacity .22s ease, transform .3s cubic-bezier(.2, .7, .2, 1), visibility 0s linear .32s; }
  .mega--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .mega::before { content: ''; position: absolute; left: 0; right: 0; top: -22px; height: 22px; }
  .nav__groupe:hover .mega, .nav__groupe:focus-within .mega, .nav__groupe.est-ouvert .mega { opacity: 1; visibility: visible; transform: translateY(0); transition-delay: 0s; }
  .mega > a { display: flex; flex-direction: column; gap: 6px; padding: 14px; border-radius: var(--r); border: 1px solid transparent; color: var(--encre); text-decoration: none; transition: background-color .22s ease, border-color .22s ease, transform .22s ease; }
  .mega > a:hover, .mega > a:focus-visible { background: var(--papier); border-color: var(--ligne); transform: translateY(-2px); color: var(--encre); }
  .mega__titre { font-family: var(--serif); font-size: 18px; line-height: 1.2; color: var(--vert); font-weight: 500; display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .mega__titre svg { flex: none; color: var(--laiton); opacity: 0; transform: translateX(-6px); transition: opacity .22s ease, transform .22s ease; }
  .mega > a:hover .mega__titre svg { opacity: 1; transform: none; }
  .mega__texte { font-size: 13px; line-height: 1.5; color: var(--muet); }
  .mega__pied { grid-column: 1 / -1; border-top: 1px solid var(--ligne); margin-top: 8px; padding-top: 14px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 20px; font-size: 13px; color: var(--muet); }
  .mega__pied a { color: var(--laiton-sombre); font-weight: 600; text-decoration: none; }
  .mega__pied a:hover { color: var(--vert); }
  .mega__pied strong { color: var(--vert); }

  .nav .nav__cta--mobile { display: none; color: var(--sur-vert); padding: 0 22px; border-radius: var(--r); font-weight: 600; }
  .nav .nav__cta--mobile::after { display: none; }
  .en-tete .burger { display: none; }

  /* ---- Smartphone / tablette : burger + panneau ---- */
  @media (max-width: 1080px) {
    .en-tete__in { flex-wrap: nowrap; }
    .en-tete .nav__cta--bureau { display: none; }
    .en-tete .burger { display: inline-flex; flex-direction: column; justify-content: center; gap: 5px; width: 44px; height: 44px; border-radius: var(--r); border: 1px solid var(--vert); background: var(--vert); cursor: pointer; padding: 0 11px; }
    .burger__trait { display: block; height: 2px; background: var(--sur-vert); border-radius: 2px; transition: transform .3s ease, opacity .3s ease; }
    .burger[aria-expanded=true] .burger__trait:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .burger[aria-expanded=true] .burger__trait:nth-child(2) { opacity: 0; }
    .burger[aria-expanded=true] .burger__trait:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .nav { position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; flex-wrap: nowrap; align-items: stretch; gap: 0; background: var(--ivoire); border-bottom: 1px solid var(--ligne); box-shadow: 0 26px 50px rgba(13, 38, 34, .18); padding: 6px 16px 20px; max-height: calc(100vh - 80px); overflow-y: auto; opacity: 0; visibility: hidden; transform: translateY(-10px); transition: opacity .25s ease, transform .3s cubic-bezier(.2, .7, .2, 1), visibility 0s linear .3s; }
    .nav.est-ouvert { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
    .nav > a, .nav__groupe > a { padding: 14px 4px; border-bottom: 1px solid var(--ligne-douce); border-radius: 0; font-size: 16px; }
    .nav > a::after, .nav__groupe > a::after { display: none; }
    .nav__groupe { display: grid; grid-template-columns: 1fr 44px; align-items: center; }
    .nav__groupe > a svg { display: none; }
    .nav__ouvrir { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; background: transparent; color: var(--laiton-sombre); cursor: pointer; }
    .nav__ouvrir svg { transition: transform .25s ease; }
    .nav__groupe.est-ouvert .nav__ouvrir svg { transform: rotate(180deg); }
    .mega { position: static; grid-column: 1 / -1; grid-template-columns: 1fr; box-shadow: none; border: 0; border-left: 2px solid var(--laiton); border-radius: 0; padding: 4px 0 8px 14px; margin: 0 0 8px; display: none; opacity: 1; visibility: visible; transform: none; }
    .nav__groupe.est-ouvert .mega { display: grid; }
    .nav__groupe:hover .mega { display: none; }
    .nav__groupe.est-ouvert:hover .mega { display: grid; }
    .mega > a { padding: 10px 8px; }
    .mega__pied { display: none; }
    .nav .nav__cta--mobile { display: inline-flex; margin-top: 14px; }
  }
</style>

<script>
  // Header compact au défilement + menu mobile + sous-menus au clavier / tactile.
  const enTete = document.getElementById('en-tete');
  const nav = enTete?.querySelector<HTMLElement>('.nav');
  const burger = enTete?.querySelector<HTMLButtonElement>('.burger');

  let compact = false;
  const surDefilement = () => {
    const s = window.scrollY > 24;
    if (s !== compact) { compact = s; enTete?.classList.toggle('est-compact', s); }
  };
  window.addEventListener('scroll', surDefilement, { passive: true });
  surDefilement();

  burger?.addEventListener('click', () => {
    const ouvert = nav?.classList.toggle('est-ouvert') ?? false;
    burger.setAttribute('aria-expanded', String(ouvert));
  });

  enTete?.querySelectorAll<HTMLElement>('.nav__groupe').forEach((groupe) => {
    const bouton = groupe.querySelector<HTMLButtonElement>('.nav__ouvrir');
    const lien = groupe.querySelector<HTMLAnchorElement>(':scope > a');
    const basculer = (force?: boolean) => {
      const ouvert = groupe.classList.toggle('est-ouvert', force);
      bouton?.setAttribute('aria-expanded', String(ouvert));
      lien?.setAttribute('aria-expanded', String(ouvert));
    };
    bouton?.addEventListener('click', () => basculer());
    // Au clavier : flèche bas ouvre, Échap ferme.
    groupe.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); basculer(true); groupe.querySelector<HTMLAnchorElement>('.mega a')?.focus(); }
      if (e.key === 'Escape') { basculer(false); lien?.focus(); }
    });
  });

  // Fermer le menu mobile au clic hors du menu.
  document.addEventListener('click', (e) => {
    if (!nav?.classList.contains('est-ouvert')) return;
    if (!(e.target as HTMLElement).closest('#en-tete')) { nav.classList.remove('est-ouvert'); burger?.setAttribute('aria-expanded', 'false'); }
  });
</script>
