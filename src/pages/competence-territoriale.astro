---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { cabinet } from '../data/cabinet';

const titre = 'Quel tribunal saisir ? Moteur de compétence territoriale';
const description = 'Quel tribunal saisir ? Moteur de compétence territoriale par code postal : tribunaux, prud’hommes et cours d’appel de toute la France, outre-mer compris.';

const faq = [
  { q: 'Quel tribunal saisir pour une succession ou un partage ?', r: '<p>Le tribunal judiciaire du lieu d’ouverture de la succession, c’est-à-dire du dernier domicile du défunt (art.&nbsp;720 et 841 du code civil, art.&nbsp;45 du code de procédure civile), pour toutes les demandes entre héritiers jusqu’au partage inclus — où que résident les héritiers et où que soient situés les biens.</p>' },
  { q: 'Quel tribunal saisir pour sortir d’une indivision hors succession ?', r: '<p>L’action en partage d’une indivision est une action mixte&nbsp;: au choix du demandeur, le tribunal judiciaire du domicile du défendeur ou celui du lieu où est situé l’immeuble (art.&nbsp;46 du code de procédure civile&nbsp;; Cass. 1re&nbsp;civ., 23&nbsp;sept. 2015, n°&nbsp;14-50.031). Entre époux, partenaires de PACS ou concubins, le partage relève du juge aux affaires familiales (art.&nbsp;L.&nbsp;213-3 du code de l’organisation judiciaire), sauf en cas de décès.</p>' },
  { q: 'Quel tribunal saisir pour une expertise avant procès (article 145) ?', r: '<p>Au choix du demandeur, la juridiction qui connaîtrait de l’affaire au fond ou celle du lieu où la mesure doit être exécutée&nbsp;; si l’expertise porte sur un immeuble, seul le tribunal du lieu de l’immeuble est compétent (art.&nbsp;145 du code de procédure civile, dans sa rédaction issue du décret n°&nbsp;2025-619 du 8&nbsp;juillet&nbsp;2025, applicable aux instances introduites depuis le 1er&nbsp;septembre&nbsp;2025).</p>' },
  { q: 'Quel juge aux affaires familiales saisir après une séparation ?', r: '<p>Celui du lieu où réside la famille ; si les parents vivent séparément, celui du lieu de résidence du parent chez lequel les enfants mineurs résident habituellement ; dans les autres cas, celui du lieu où réside la partie qui n’a pas pris l’initiative de la procédure (art.&nbsp;1070 du code de procédure civile). La compétence s’apprécie au jour de la demande.</p>' },
  { q: 'Quel conseil de prud’hommes saisir ?', r: '<p>Celui du lieu de l’établissement où le travail est accompli ; si le travail est accompli à domicile ou hors de tout établissement, celui du domicile du salarié. Le salarié peut aussi choisir le conseil du lieu où le contrat a été conclu ou celui du lieu où l’employeur est établi (art.&nbsp;R.&nbsp;1412-1 du code du travail).</p>' },
  { q: 'Quel commissaire de justice est compétent ?', r: '<p>Pour signifier un acte ou exécuter une décision&nbsp;: un commissaire de justice dont l’office est situé dans le ressort de la cour d’appel. Pour un constat&nbsp;: n’importe quel commissaire de justice, sur tout le territoire national (décret n°&nbsp;2021-1625 du 10&nbsp;décembre&nbsp;2021, art.&nbsp;1er). Le moteur indique la cour d’appel dont dépend chaque commune&nbsp;; l’annuaire officiel de la Chambre nationale des commissaires de justice permet ensuite de trouver un office.</p>' },
  { q: 'Le moteur couvre-t-il l’outre-mer ?', r: '<p>Oui&nbsp;: Guadeloupe, Martinique, Guyane, La Réunion et Mayotte, ainsi que Saint-Pierre-et-Miquelon, Saint-Barthélemy, Saint-Martin, la Nouvelle-Calédonie, la Polynésie française, Wallis-et-Futuna et même les Terres australes et l’île de Clipperton, selon le fichier officiel du ministère de la Justice. Dans les collectivités du Pacifique et à Saint-Pierre-et-Miquelon, l’organisation judiciaire et la procédure obéissent en partie à des textes propres.</p>' },
  { q: 'Mon code postal couvre plusieurs communes : laquelle compte ?', r: '<p>La compétence s’apprécie par commune, non par code postal. Un même code postal peut couvrir des communes rattachées à des tribunaux différents : le moteur ci-dessus vous demande alors de préciser la commune.</p>' },
  { q: 'Le cabinet peut-il plaider devant tous ces tribunaux ?', r: '<p>Oui. Le cabinet postule directement devant tous les tribunaux judiciaires du ressort de la cour d’appel de Rennes (Côtes-d’Armor, Finistère, Ille-et-Vilaine, Loire-Atlantique, Morbihan) et plaide devant les conseils de prud’hommes et les autres juridictions de France ; devant les tribunaux judiciaires des autres cours d’appel, il s’adjoint si nécessaire un confrère postulant.</p>' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: titre,
  description,
  url: `${cabinet.siteUrl}/competence-territoriale`,
  isPartOf: { '@id': `${cabinet.siteUrl}/#cabinet` },
  about: ['Compétence territoriale', 'Tribunal judiciaire', 'Tribunal de proximité', 'Conseil de prud’hommes', 'Cour d’appel'],
  spatialCoverage: ['France métropolitaine', 'Outre-mer'],
  dateModified: '2026-10-26',
};
---
<Base title={titre} description={description} jsonLd={jsonLd} fil={[{ label: 'Services en ligne', href: '/services' }, { label: 'Quel tribunal saisir ?', href: '/competence-territoriale' }]}>
  <section class="hero-clair" style="background: var(--ivoire); border-bottom: 1px solid var(--ligne)">
    <div class="conteneur pile entree" style="padding-top: 64px; padding-bottom: 48px; gap: 18px; max-width: 880px">
      <p class="surtitre">Moteur de compétence territoriale · France entière</p>
      <h1>Quel tribunal saisir&nbsp;?</h1>
      <p class="chapo">Tribunaux judiciaires, tribunaux de proximité, conseils de prud’hommes et cours d’appel de toute la France, outre-mer compris. Saisissez un code postal ou une commune&nbsp;: la page indique les juridictions dont elle dépend, les situe sur la carte, précise le ressort des commissaires de justice et rappelle les règles de compétence territoriale en droit de la famille, des successions, de l’indivision, des référés, de l’expertise et du travail.</p>
    </div>
  </section>

  <section class="section" id="moteur">
    <div class="conteneur pile" style="gap: 28px">
      <div class="pile" style="gap: 10px; max-width: 720px">
        <p class="surtitre">Moteur de compétence territoriale</p>
        <h2>De quel tribunal dépend votre commune&nbsp;?</h2>
        <p class="muet">Ressorts officiels du ministère de la Justice (mise à jour de juillet&nbsp;2026)&nbsp;: les 35&nbsp;029 communes et territoires de France, métropole et outre-mer — départements et régions d’outre-mer, Saint-Pierre-et-Miquelon, Saint-Barthélemy, Saint-Martin, Nouvelle-Calédonie, Polynésie française, Wallis-et-Futuna.</p>
      </div>
      <form class="recherche" id="form-recherche" autocomplete="off" novalidate>
        <label class="champ" style="flex: 1 1 320px">
          <span>Code postal ou commune</span>
          <input type="search" id="q" name="q" inputmode="search" placeholder="35000, Lyon 3e, Fort-de-France, 98800…" aria-describedby="aide-q" />
        </label>
        <p id="aide-q" class="muet" style="font-size: 14px; flex-basis: 100%; margin: 0">Un code postal peut couvrir plusieurs communes aux ressorts différents&nbsp;: choisissez alors la commune dans la liste.</p>
      </form>
      <div id="propositions" class="propositions" role="listbox" aria-label="Communes correspondantes" hidden></div>
      <div id="resultat" class="resultat" aria-live="polite" hidden></div>
      <noscript><p class="muet">Le moteur nécessite JavaScript. Le fichier des ressorts est téléchargeable&nbsp;: <a href="/data/competence-territoriale.json">competence-territoriale.json</a>.</p></noscript>
    </div>
  </section>

  <section class="section section--ivoire" id="carte">
    <div class="conteneur pile" style="gap: 24px">
      <div class="pile" style="gap: 10px; max-width: 720px">
        <p class="surtitre">Carte</p>
        <h2>Les juridictions de France</h2>
        <p class="muet">164 tribunaux judiciaires et 4 tribunaux de première instance, 125 tribunaux de proximité, 211 conseils de prud’hommes et 5 tribunaux du travail, 36 cours d’appel et un tribunal supérieur d’appel. Les boutons sous la carte mènent à l’outre-mer&nbsp;; cliquez sur un repère pour l’adresse, le téléphone et les horaires d’accueil.</p>
      </div>
      <div class="legende" role="group" aria-label="Filtrer les juridictions affichées">
        <label><input type="checkbox" data-type="TJ" checked /> <span class="puce puce--TJ"></span> Tribunaux judiciaires et de première instance</label>
        <label><input type="checkbox" data-type="TPRX" checked /> <span class="puce puce--TPRX"></span> Tribunaux de proximité</label>
        <label><input type="checkbox" data-type="CPH" checked /> <span class="puce puce--CPH"></span> Prud’hommes et tribunaux du travail</label>
        <label><input type="checkbox" data-type="CA" checked /> <span class="puce puce--CA"></span> Cours d’appel</label>
      </div>
      <div id="map" class="map" role="region" aria-label="Carte des juridictions de France"></div>
      <div id="outremer" class="outremer" role="group" aria-label="Aller sur la carte de l’outre-mer"></div>
      <p class="muet" style="font-size: 13px">Fond de carte IGN — Géoplateforme&nbsp;; OpenStreetMap pour la Nouvelle-Calédonie, la Polynésie française et Wallis-et-Futuna. Adresses et horaires&nbsp;: annuaire de l’administration (service-public.gouv.fr), susceptibles de changer&nbsp;: vérifiez avant de vous déplacer.</p>
    </div>
  </section>

  <section class="section" id="regles">
    <div class="conteneur pile" style="gap: 28px">
      <div class="pile" style="gap: 10px; max-width: 760px">
        <p class="surtitre">Les règles</p>
        <h2>Compétence territoriale&nbsp;: les principales règles</h2>
        <p class="muet">Savoir <em>quel</em> tribunal est le bon n’est pas un détail&nbsp;: une assignation délivrée devant un tribunal territorialement incompétent fait perdre des mois, et l’exception d’incompétence doit être soulevée dès les premières écritures. Les règles ci-dessous sont celles du code de procédure civile, du code civil, du code de l’organisation judiciaire et du code du travail en vigueur au 25&nbsp;octobre&nbsp;2026.</p>
        <p class="muet"><strong>Outre-mer.</strong> Ces règles valent dans les départements et régions d’outre-mer. À Saint-Pierre-et-Miquelon, la justice civile de première instance est rendue par un tribunal de première instance, avec un tribunal supérieur d’appel&nbsp;; en Nouvelle-Calédonie, en Polynésie française et à Wallis-et-Futuna, par un tribunal de première instance et, pour les litiges du travail, par un tribunal du travail. L’organisation judiciaire et la procédure y obéissent en partie à des textes propres&nbsp;: vérifiez les règles locales avant d’agir.</p>
      </div>
      <div class="grille grille--2 regles">
        <article class="carte">
          <h3>Le principe&nbsp;: le tribunal du défendeur</h3>
          <p class="muet">Sauf disposition contraire, la juridiction compétente est celle du lieu où demeure le défendeur&nbsp;: son domicile ou, à défaut, sa résidence pour une personne physique&nbsp;; le lieu où elle est établie pour une personne morale (art.&nbsp;42 et 43 CPC). S’il y a plusieurs défendeurs, le demandeur choisit le tribunal de l’un d’eux. Si le défendeur n’a ni domicile ni résidence connus, le demandeur peut saisir le tribunal de son propre domicile.</p>
          <p class="muet">Options du demandeur (art.&nbsp;46 CPC)&nbsp;: en matière contractuelle, le lieu de livraison ou d’exécution de la prestation&nbsp;; en matière délictuelle, le lieu du fait dommageable ou celui où le dommage a été subi&nbsp;; en matière mixte, le lieu de l’immeuble&nbsp;; en matière d’aliments ou de contribution aux charges du mariage, le lieu où demeure le créancier.</p>
        </article>
        <article class="carte">
          <h3>Successions et partages successoraux</h3>
          <p class="muet">Jusqu’au partage inclus, les demandes entre héritiers, celles des créanciers du défunt et celles relatives à l’exécution des dispositions à cause de mort (testaments, legs) sont portées devant le tribunal dans le ressort duquel la succession est ouverte (art.&nbsp;45 CPC), c’est-à-dire au <strong>dernier domicile du défunt</strong> (art.&nbsp;720 C.&nbsp;civ.). Peu importent le domicile des héritiers et la situation des immeubles.</p>
          <p class="muet">Ce tribunal est <strong>exclusivement</strong> compétent pour l’action en partage, les contestations nées du maintien de l’indivision ou survenues au cours des opérations, les licitations, la garantie des lots, la nullité du partage et le complément de part (art.&nbsp;841 C.&nbsp;civ., dans sa rédaction issue de la loi n°&nbsp;2026-248 du 7&nbsp;avril&nbsp;2026, qui reconnaît aussi la compétence du juge commis pour trancher les contestations et ordonner les licitations). Voir notre analyse de la <a href="/fiches/reforme-partage-judiciaire-2027">réforme du partage judiciaire applicable au 1er&nbsp;janvier&nbsp;2027</a>.</p>
        </article>
        <article class="carte">
          <h3>Indivision, immeubles, patrimoine</h3>
          <p class="muet">En matière réelle immobilière (revendication, servitude, bornage, action en nullité d’une vente immobilière…), le tribunal du lieu de l’immeuble est <strong>seul</strong> compétent (art.&nbsp;44 CPC). L’<strong>action en partage d’une indivision hors succession</strong> est une action mixte, qui met en cause à la fois un droit personnel et un droit réel — qualification approuvée par la Cour de cassation (Cass. 1re&nbsp;civ., 23&nbsp;sept. 2015, n°&nbsp;14-50.031) et appliquée par les juges du fond (TJ Lyon, 4&nbsp;août 2026, RG n°&nbsp;25/05007)&nbsp;: le demandeur choisit entre le tribunal du domicile du défendeur — de l’un d’eux s’il y en a plusieurs — et celui du lieu où est situé l’immeuble (art.&nbsp;42 et 46 CPC)&nbsp;; s’il y a plusieurs immeubles, le lieu de l’un d’eux suffit (TJ Paris, 9&nbsp;avr. 2025, RG n°&nbsp;24/10716).</p>
          <p class="muet">Entre époux, partenaires de PACS ou concubins, la liquidation et le partage des intérêts patrimoniaux, le fonctionnement du régime matrimonial et l’indivision relèvent du juge aux affaires familiales (art.&nbsp;L.&nbsp;213-3 COJ), territorialement désigné selon l’article&nbsp;1070 CPC ci-contre — sauf en cas de décès, où l’on revient aux règles successorales. Pour les <strong>SCI familiales</strong>, c’est le siège social qui fixe le tribunal du défendeur (art.&nbsp;43 CPC)&nbsp;; une clause attributive de compétence n’est valable qu’entre commerçants (art.&nbsp;48 CPC).</p>
        </article>
        <article class="carte">
          <h3>Affaires familiales&nbsp;: divorce, enfants, pensions</h3>
          <p class="muet">Le juge aux affaires familiales territorialement compétent est (art.&nbsp;1070 CPC)&nbsp;: celui du lieu où se trouve la <strong>résidence de la famille</strong>&nbsp;; si les parents vivent séparément, celui du lieu de résidence du parent avec lequel résident habituellement les enfants mineurs (autorité parentale conjointe) ou du parent qui exerce seul l’autorité parentale&nbsp;; dans les autres cas, celui du lieu où réside celui qui <strong>n’a pas pris l’initiative</strong> de la procédure. En cas de demande conjointe, les parties choisissent le juge du lieu de résidence de l’une ou de l’autre.</p>
          <p class="muet">Lorsque le litige porte seulement sur la pension alimentaire, la contribution à l’entretien et à l’éducation de l’enfant, la contribution aux charges du mariage ou la prestation compensatoire, le juge peut être celui du lieu où réside l’époux créancier ou le parent qui assume à titre principal la charge des enfants, même majeurs. La compétence s’apprécie au jour de la demande&nbsp;: un déménagement postérieur ne la modifie pas.</p>
        </article>
        <article class="carte">
          <h3>Référés</h3>
          <p class="muet">Le président du tribunal judiciaire statue en référé dans tous les cas d’urgence, ou pour prévenir un dommage imminent, faire cesser un trouble manifestement illicite ou accorder une provision (art.&nbsp;834 et 835 CPC). En principe, le juge des référés territorialement compétent est celui de la juridiction qui connaîtrait de l’affaire au fond, selon les règles ci-dessus&nbsp;: pour une succession, le président du tribunal du lieu d’ouverture&nbsp;; pour une indivision hors succession, au choix, celui du domicile du défendeur ou du lieu de l’immeuble. L’expertise obéit à des règles propres (ci-dessous).</p>
          <p class="muet">Une fois le tribunal saisi au fond et le juge de la mise en état désigné, c’est lui seul, à l’exclusion de toute autre formation du tribunal, qui accorde les provisions et ordonne les mesures provisoires et les mesures d’instruction (art.&nbsp;789 CPC).</p>
        </article>
        <article class="carte">
          <h3>Prud’hommes</h3>
          <p class="muet">Le conseil de prud’hommes compétent est celui dans le ressort duquel est situé l’<strong>établissement où le travail est accompli</strong>&nbsp;; lorsque le travail est accompli à domicile ou en dehors de toute entreprise ou établissement (télétravail intégral, itinérants, VRP), celui du <strong>domicile du salarié</strong>. Le salarié peut également saisir le conseil du lieu où l’engagement a été contracté ou celui du lieu où l’employeur est établi (art.&nbsp;R.&nbsp;1412-1 C.&nbsp;trav.). Toute clause du contrat de travail qui y déroge est réputée non écrite (art.&nbsp;R.&nbsp;1412-4).</p>
          <p class="muet">Le ressort des conseils de prud’hommes ne coïncide pas toujours avec celui des tribunaux judiciaires&nbsp;: une commune peut dépendre du tribunal judiciaire de Rennes et du conseil de prud’hommes de Saint-Malo, ou du tribunal de Saint-Brieuc et du conseil de Guingamp ou de Dinan. Vérifiez avec le moteur ci-dessus.</p>
        </article>
        <article class="carte carte--large carte--accent" id="expertise">
          <h3>Expertise avant procès&nbsp;: les règles spéciales de l’article&nbsp;145</h3>
          <p class="muet">Lorsqu’il existe un motif légitime de conserver ou d’établir, avant tout procès, la preuve de faits dont pourrait dépendre la solution d’un litige, une expertise, un constat ou la production de pièces peuvent être ordonnés sur requête ou en référé. Depuis le décret n°&nbsp;2025-619 du 8&nbsp;juillet&nbsp;2025, l’article&nbsp;145 CPC fixe lui-même la compétence territoriale&nbsp;:</p>
          <ul class="regles__liste">
            <li><strong>Une option pour le demandeur.</strong> La juridiction susceptible de connaître de l’affaire au fond ou, s’il y a lieu, celle dans le ressort de laquelle la mesure d’instruction doit être exécutée.</li>
            <li><strong>Une compétence exclusive pour les immeubles.</strong> Lorsque la mesure porte sur un immeuble, la juridiction du lieu où il est situé est seule compétente — même si le procès au fond relèvera d’un autre tribunal. Exemple&nbsp;: avant toute assignation en partage, l’expertise de la maison de famille de Saint-Malo se demande au président du tribunal judiciaire de Saint-Malo, alors que le partage de la succession, ouverte à Nantes, sera jugé à Nantes.</li>
            <li><strong>Avant tout procès seulement.</strong> Une fois le tribunal saisi au fond et le juge de la mise en état désigné, c’est à ce dernier que l’expertise se demande (art.&nbsp;789, 5°&nbsp;CPC).</li>
            <li><strong>Dans le temps.</strong> Ces règles s’appliquent aux seules instances introduites à compter du 1er&nbsp;septembre&nbsp;2025&nbsp;; les instances antérieures restent régies par l’ancienne rédaction du texte.</li>
          </ul>
        </article>
      </div>
      <div class="encadre" style="max-width: 980px">
        <h3 style="margin-top: 0">Trois précisions utiles</h3>
        <ul class="carte__liste">
          <li><strong>Tribunal de proximité.</strong> C’est une chambre détachée du tribunal judiciaire, siégeant dans une autre ville (art.&nbsp;L.&nbsp;212-8 COJ), compétente pour les contentieux listés aux tableaux IV-II et IV-III annexés au code de l’organisation judiciaire (art.&nbsp;D.&nbsp;212-19-1) — pour l’essentiel les petits litiges civils et certains contentieux de la protection. Les successions, partages, divorces et affaires familiales restent au siège du tribunal judiciaire. Lorsque le moteur n’affiche aucun tribunal de proximité, la commune relève directement du siège.</li>
          <li><strong>Magistrats et auxiliaires de justice.</strong> Lorsqu’un magistrat ou un auxiliaire de justice (avocat, notaire, commissaire de justice…) est partie au litige dans le ressort où il exerce, le demandeur peut saisir une juridiction d’un ressort limitrophe, et le défendeur demander le renvoi (art.&nbsp;47 CPC).</li>
          <li><strong>Postulation.</strong> Devant le tribunal judiciaire, lorsque la représentation est obligatoire, seul un avocat inscrit dans le ressort de la cour d’appel peut accomplir les actes de procédure. Le cabinet postule devant tous les tribunaux judiciaires du ressort de la cour d’appel de Rennes — Rennes, Saint-Malo, Saint-Brieuc, Brest, Quimper, Lorient, Vannes, <strong>Nantes et Saint-Nazaire</strong> — et plaide dans toute la France, avec un confrère postulant lorsque c’est nécessaire.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--ivoire">
    <div class="conteneur" style="max-width: 880px">
      <Faq items={faq} />
    </div>
  </section>

  <Cta titre="Un doute sur le tribunal à saisir ?" texte="Le choix de la juridiction se décide avec la stratégie du dossier : délais, mesures provisoires, exécution. Le cabinet vous répond par écrit ou en rendez-vous, à Rennes, en visio ou par téléphone." />

  <section class="section" id="sources">
    <div class="conteneur pile" style="gap: 10px; max-width: 880px">
      <p class="surtitre">Sources</p>
      <ul class="carte__liste muet" style="font-size: 14px">
        <li>Ministère de la Justice, <em>Liste des juridictions compétentes pour les communes de France</em>, édition de juillet 2026 (data.gouv.fr, licence ouverte).</li>
        <li>Annuaire de l’administration, base de données locales de service-public.gouv.fr (DILA), extraction du 25 octobre 2026 — adresses, téléphones, horaires, coordonnées.</li>
        <li>La Poste, base officielle des codes postaux (correspondance commune – code postal).</li>
        <li>Articles 42 à 48, 145, 789, 834, 835 et 1070 du code de procédure civile&nbsp;; 720 et 841 du code civil&nbsp;; L.&nbsp;212-8, L.&nbsp;213-3 et D.&nbsp;212-19-1 du code de l’organisation judiciaire&nbsp;; R.&nbsp;1412-1 et R.&nbsp;1412-4 du code du travail (Légifrance, versions en vigueur au 25 octobre 2026).</li>
        <li>Ordonnance n°&nbsp;2016-728 du 2&nbsp;juin&nbsp;2016 relative au statut de commissaire de justice, art.&nbsp;1er&nbsp;; décret n°&nbsp;2021-1625 du 10&nbsp;décembre&nbsp;2021 relatif aux compétences des commissaires de justice, art.&nbsp;1er (Légifrance).</li>
        <li>Cass. 1re&nbsp;civ., 23&nbsp;septembre&nbsp;2015, n°&nbsp;14-50.031&nbsp;; TJ Paris, 9&nbsp;avril&nbsp;2025, RG n°&nbsp;24/10716&nbsp;; TJ Lyon, 4&nbsp;août&nbsp;2026, RG n°&nbsp;25/05007 (Judilibre).</li>
      </ul>
      <p class="muet" style="font-size: 14px">Cette page est un outil d’orientation, pas une consultation&nbsp;: les règles comportent des exceptions (clauses attributives, litiges internationaux, procédures collectives, contentieux de la protection…), et les ressorts évoluent. Avant d’assigner, faites vérifier la compétence par un avocat.</p>
    </div>
  </section>
</Base>

<style>
  .recherche { display: flex; flex-wrap: wrap; gap: 14px 20px; align-items: flex-end; max-width: 720px; }
  .recherche input { font-size: 18px; }
  .propositions { display: flex; flex-wrap: wrap; gap: 8px; max-width: 920px; }
  .propositions button { font: inherit; font-size: 14.5px; padding: 8px 14px; border: 1px solid var(--ligne); border-radius: 999px; background: var(--ivoire); color: var(--encre); cursor: pointer; transition: border-color .2s ease, color .2s ease; }
  .propositions button:hover, .propositions button[aria-selected=true] { border-color: var(--laiton); color: var(--laiton-sombre); }
  .propositions button small { color: var(--muet); }
  .resultat { display: flex; flex-direction: column; gap: 18px; }
  .resultat__titre { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
  .resultat__titre h3 { font-size: 26px; margin: 0; }
  .juridictions { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 16px; }
  .jur { background: var(--ivoire); border: 1px solid var(--ligne); border-radius: var(--r); padding: 20px 22px; display: flex; flex-direction: column; gap: 8px; border-top: 3px solid var(--laiton); }
  .jur--TJ { border-top-color: #11352F; } .jur--TPRX { border-top-color: #9A7B4F; } .jur--CPH { border-top-color: #2F5D8A; } .jur--CA { border-top-color: #8A2F2F; } .jur--CJ { border-top-color: #5E6B63; }
  .jur .etiquette { font-size: 11.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--laiton-sombre); }
  .jur h4 { font-size: 18px; margin: 0; line-height: 1.25; }
  .jur p { margin: 0; font-size: 14.5px; color: var(--muet); }
  .jur .actions { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 14px; margin-top: 4px; }
  .jur .actions a, .jur .actions button { font: inherit; font-size: 14px; color: var(--laiton-sombre); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .jur--vide { border-style: dashed; }
  .outremer { display: flex; flex-wrap: wrap; gap: 8px; }
  .outremer :global(button) { font: inherit; font-size: 14px; padding: 7px 13px; border: 1px solid var(--ligne); border-radius: 999px; background: var(--papier); color: var(--encre); cursor: pointer; }
  .outremer :global(button:hover) { border-color: var(--laiton); color: var(--laiton-sombre); }
  .legende { display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 14.5px; }
  .legende label { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
  .puce { display: inline-block; width: 14px; height: 14px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.25); }
  .puce--TJ { background: #11352F; } .puce--TPRX { background: #9A7B4F; } .puce--CPH { background: #2F5D8A; } .puce--CA { background: #8A2F2F; }
  .map { height: min(72vh, 680px); min-height: 420px; border: 1px solid var(--ligne); border-radius: var(--r); background: #EEF0EA; z-index: 0; }
  .map :global(.leaflet-popup-content) { font: 14px/1.45 inherit; margin: 14px 16px; }
  .map :global(.leaflet-popup-content h4) { margin: 0 0 6px; font-size: 16px; }
  .map :global(.leaflet-popup-content p) { margin: 0 0 4px; }
  .map :global(.leaflet-container a) { color: var(--laiton-sombre); }
  .map :global(.leaflet-container) { font-family: inherit; }
  .regles .carte { gap: 10px; }
  .regles .carte h3 { font-size: 21px; }
  .regles .carte p { font-size: 15px; }
  .regles .carte--large { grid-column: 1 / -1; }
  .regles .carte--accent { border-left: 3px solid var(--laiton); }
  .regles__liste { margin: 0; padding-left: 1.1em; display: grid; gap: 8px; color: var(--muet); font-size: 15px; }
  .regles__liste strong { color: var(--encre); }
  .encadre { background: var(--ivoire); border: 1px solid var(--ligne); border-left: 3px solid var(--laiton); border-radius: var(--r); padding: 24px 28px; }
  .encadre li { font-size: 15px; }
  .avertissement { font-size: 14px; color: var(--muet); border-top: 1px solid var(--ligne-douce); padding-top: 10px; }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Type = 'CA' | 'TJ' | 'TPRX' | 'CPH';
  type Jur = { i: string; t: Type; l: string; n: string; a: string; cp: string; v: string; lat: number; lon: number; tel: string | null; url: string; h: string | null };
  type Ligne = [string, string, string, number, number, number, number]; // insee, nom, codes postaux, CA, TJ, TPRX (-1 si aucun), CPH
  type Donnees = { maj: string; deps: Record<string, string>; j: Jur[]; c: Ligne[] };
  type Commune = { insee: string; nom: string; norm: string; cps: string[]; ca: number; tj: number; tprx: number; cph: number; dep: string };

  const COULEURS: Record<Type, string> = { TJ: '#11352F', TPRX: '#9A7B4F', CPH: '#2F5D8A', CA: '#8A2F2F' };
  const DECALAGE: Record<Type, [number, number]> = { TJ: [0, 0], TPRX: [0, 0.006], CPH: [0, -0.006], CA: [0.005, 0] };
  // Collectivités où l'organisation judiciaire et la procédure obéissent en partie à des textes propres
  const COLLECTIVITES = ['975', '984', '986', '987', '988', '989'];
  const OUTRE_MER: [string, number, number, number][] = [
    ['Guadeloupe', 16.17, -61.55, 10], ['Martinique', 14.64, -61.02, 10], ['Guyane', 4.4, -53.1, 8],
    ['La Réunion', -21.12, 55.53, 10], ['Mayotte', -12.82, 45.15, 11], ['Saint-Pierre-et-Miquelon', 46.95, -56.3, 10],
    ['Saint-Martin, Saint-Barthélemy', 17.98, -62.95, 11], ['Nouvelle-Calédonie', -21.3, 165.6, 7],
    ['Polynésie française', -17.65, -149.45, 10], ['Wallis-et-Futuna', -13.8, -177.2, 9],
  ];
  const METROPOLE = L.latLngBounds([41.3, -5.2], [51.1, 9.6]);
  // Le Plan IGN ne couvre pas le Pacifique : OpenStreetMap y prend le relais
  const PACIFIQUE = [L.latLngBounds([-23.5, 162.5], [-19, 168.5]), L.latLngBounds([-28.5, -155], [-7, -134]), L.latLngBounds([-14.5, -178.5], [-13, -175.5])];
  const NBSP = ' ';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector(s) as T;
  const champ = $<HTMLInputElement>('#q');
  const propositions = $<HTMLDivElement>('#propositions');
  const resultat = $<HTMLDivElement>('#resultat');
  const mapEl = $<HTMLDivElement>('#map');

  const normaliser = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/œ/g, 'oe').replace(/æ/g, 'ae').replace(/[^a-z0-9]+/g, ' ').replace(/\bste?\b/g, (m) => (m === 'st' ? 'saint' : 'sainte')).trim();
  const echapper = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  const telHref = (t: string) => 'tel:' + t.replace(/[^\d+]/g, '');
  const depDe = (insee: string) => (insee.startsWith('97') || insee.startsWith('98') ? insee.slice(0, 3) : insee.slice(0, 2));
  const ressort = (ca: Jur) => ca.n.replace(/^Cour d’appel/, 'cour d’appel').replace(/^Tribunal supérieur d’appel/, 'tribunal supérieur d’appel');

  let donnees: Donnees;
  let communes: Commune[] = [];
  let map: L.Map;
  const marqueurs: L.CircleMarker[] = [];
  const groupes: Record<string, L.LayerGroup> = {};
  let selection: number[] = [];

  async function charger() {
    const r = await fetch('/data/competence-territoriale.json?v=2026-07-fr');
    donnees = await r.json();
    communes = donnees.c.map(([insee, nom, cps, ca, tj, tprx, cph]) => ({ insee, nom, norm: normaliser(nom), cps: cps ? cps.split(' ') : [], ca, tj, tprx, cph, dep: depDe(insee) }));
    initCarte();
    champ.disabled = false;
    champ.placeholder = '35000, Lyon 3e, Fort-de-France, 98800…';
    // ?q=… (encarts du site, formulaire sans JavaScript) ou #q=… (lien partagé depuis la page)
    const q = new URLSearchParams(location.search).get('q') ?? new URLSearchParams(location.hash.replace(/^#/, '')).get('q');
    if (q) {
      champ.value = q;
      chercher(q, true);
      if (resultat.hidden) {
        const exactes = communes.filter((c) => c.norm === normaliser(q));
        if (exactes.length === 1) afficher(exactes[0]);
      }
      document.getElementById('moteur')?.scrollIntoView({ block: 'start' });
    }
  }

  const cle = (c: Commune) => `${c.ca}|${c.tj}|${c.tprx}|${c.cph}`;
  const memesJuridictions = (cs: Commune[]) => cs.every((c) => cle(c) === cle(cs[0]));

  function chercher(brut: string, auto = false) {
    const q = brut.trim();
    propositions.innerHTML = '';
    // nouvelle recherche : l'ancien résultat et sa mise en valeur sur la carte disparaissent
    resultat.hidden = true;
    if (selection.length) { selection = []; mettreEnValeur([]); }
    if (q.length < 2) { propositions.hidden = true; return; }
    let trouvees: Commune[];
    if (/^\d+$/.test(q) || /^2[ab]\d*$/i.test(q)) {
      trouvees = communes.filter((c) => c.cps.some((cp) => cp.startsWith(q)));
    } else {
      const n = normaliser(q);
      trouvees = communes.filter((c) => c.norm.startsWith(n));
      if (trouvees.length < 8) trouvees = trouvees.concat(communes.filter((c) => !c.norm.startsWith(n) && c.norm.includes(n)));
    }
    if (trouvees.length === 0) {
      propositions.hidden = false;
      propositions.innerHTML = `<p class="muet" style="margin:0">Aucune commune trouvée pour «${NBSP}${echapper(q)}${NBSP}». Vérifiez l’orthographe ou essayez le code postal.</p>`;
      resultat.hidden = true;
      return;
    }
    const liste = trouvees.slice(0, 40);
    propositions.hidden = false;
    propositions.innerHTML = liste.map((c, k) => `<button type="button" role="option" data-k="${k}">${echapper(c.nom)} <small>${c.cps[0] ?? ''} · ${echapper(donnees.deps[c.dep] ?? '')}</small></button>`).join('')
      + (trouvees.length > 40 ? `<p class="muet" style="margin:0;flex-basis:100%;font-size:14px">${trouvees.length.toLocaleString('fr-FR')} communes${NBSP}: précisez.</p>` : '');
    (propositions as any)._liste = liste;
    const cpComplet = /^\d{5}$/.test(q);
    const exactes = cpComplet ? [] : trouvees.filter((c) => c.norm === normaliser(q));
    if (trouvees.length === 1) afficher(trouvees[0]);
    else if (cpComplet && memesJuridictions(trouvees)) afficher(trouvees[0], trouvees);
    else if (exactes.length === 1) afficher(exactes[0]);
  }

  function carteJur(idx: number, type: Type) {
    if (idx < 0) {
      return `<div class="jur jur--${type} jur--vide"><span class="etiquette">Tribunal de proximité</span><h4>Pas de tribunal de proximité</h4><p>Cette commune relève directement du siège du tribunal, y compris pour les contentieux habituellement confiés aux chambres de proximité.</p></div>`;
    }
    const j = donnees.j[idx];
    return `<div class="jur jur--${type}"><span class="etiquette">${echapper(j.l)}</span><h4>${echapper(j.n)}</h4><p>${echapper(j.a)}${j.a ? '<br>' : ''}${j.cp} ${echapper(j.v)}</p>${j.h ? `<p>Accueil${NBSP}: ${echapper(j.h)}</p>` : ''}<div class="actions">${j.tel ? `<a href="${telHref(j.tel)}">${echapper(j.tel)}</a>` : ''}<button type="button" data-voir="${idx}">Voir sur la carte</button><a href="${j.url}" rel="noopener">Fiche annuaire</a></div></div>`;
  }

  function carteCommissaire(c: Commune) {
    if (COLLECTIVITES.includes(c.dep)) return '';
    const ca = donnees.j[c.ca];
    return `<div class="jur jur--CJ"><span class="etiquette">Commissaire de justice</span><h4>Ressort de la ${echapper(ressort(ca))}</h4><p>Pour signifier un acte ou exécuter une décision${NBSP}: un commissaire de justice dont l’office est situé dans ce ressort. Pour un constat${NBSP}: n’importe quel commissaire de justice, partout en France (décret n°${NBSP}2021-1625, art.${NBSP}1er).</p><div class="actions"><a href="https://annuaire.commissaire-justice.fr/" rel="noopener">Annuaire officiel des commissaires de justice</a></div></div>`;
  }

  function afficher(c: Commune, groupe?: Commune[]) {
    propositions.querySelectorAll<HTMLButtonElement>('button[data-k]').forEach((b) => {
      const liste = (propositions as any)._liste as Commune[] | undefined;
      b.setAttribute('aria-selected', String(!!liste && liste[Number(b.dataset.k)] === c));
    });
    const titre = groupe && groupe.length > 1
      ? `<h3>Code postal ${c.cps.find((cp) => groupe.every((g) => g.cps.includes(cp))) ?? c.cps[0]}</h3><span class="muet">${groupe.length} communes, mêmes juridictions${NBSP}: ${echapper(groupe.map((g) => g.nom).join(', '))}</span>`
      : `<h3>${echapper(c.nom)}</h3><span class="muet">${c.cps.join(', ')}${c.cps.length ? ' · ' : ''}${echapper(donnees.deps[c.dep] ?? '')}</span>`;
    const ca = donnees.j[c.ca];
    const notes: string[] = [];
    notes.push(ca.i === 'CA-11'
      ? `Ressort de la cour d’appel de Rennes${NBSP}: le cabinet postule directement devant ce tribunal judiciaire et plaide devant le conseil de prud’hommes et la cour.`
      : `Hors ressort de la cour d’appel de Rennes${NBSP}: le cabinet plaide devant ces juridictions et s’adjoint, lorsque la postulation est obligatoire devant le tribunal, un confrère du ressort.`);
    if (COLLECTIVITES.includes(c.dep)) notes.push(`Collectivité d’outre-mer${NBSP}: l’organisation judiciaire et la procédure y obéissent en partie à des textes propres (tribunal de première instance, tribunal du travail ou tribunal supérieur d’appel)${NBSP}; vérifiez les règles locales avant d’agir.`);
    notes.push(`Successions et partages${NBSP}: la commune à retenir est celle du <strong>dernier domicile du défunt</strong>${NBSP}; affaires familiales${NBSP}: celle de la résidence de la famille ou des enfants${NBSP}; expertise d’un immeuble avant tout procès${NBSP}: celle où se trouve l’immeuble (<a href="#regles">voir les règles</a>).`);
    resultat.hidden = false;
    resultat.innerHTML = `<div class="resultat__titre">${titre}</div>
      <div class="juridictions">${carteJur(c.tj, 'TJ')}${carteJur(c.tprx, 'TPRX')}${carteJur(c.cph, 'CPH')}${carteJur(c.ca, 'CA')}${carteCommissaire(c)}</div>
      <p class="avertissement">${notes.join(' ')}</p>`;
    selection = [c.tj, c.tprx, c.cph, c.ca].filter((i) => i >= 0);
    mettreEnValeur([c.tj, c.tprx, c.cph].filter((i) => i >= 0));
    history.replaceState(null, '', location.pathname + '#q=' + encodeURIComponent(champ.value.trim()));
  }

  function initCarte() {
    map = L.map(mapEl, { scrollWheelZoom: false, preferCanvas: true, attributionControl: true });
    L.tileLayer('https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2&STYLE=normal&TILEMATRIXSET=PM&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}&FORMAT=image%2Fpng', {
      attribution: '© <a href="https://www.ign.fr/" rel="noopener">IGN</a> – Géoplateforme · Ressorts © Ministère de la Justice (07/2026)', maxZoom: 18, minZoom: 2,
    }).addTo(map);
    for (const b of PACIFIQUE) {
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { bounds: b, maxZoom: 18, attribution: '© <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a>' }).addTo(map);
    }
    map.fitBounds(METROPOLE);
    for (const t of ['CA', 'CPH', 'TPRX', 'TJ']) groupes[t] = L.layerGroup().addTo(map);
    donnees.j.forEach((j, idx) => {
      const [dlat, dlon] = DECALAGE[j.t];
      const m = L.circleMarker([j.lat + dlat, j.lon + dlon], { radius: j.t === 'TJ' || j.t === 'CA' ? 6 : 4.5, color: '#fff', weight: 1.2, fillColor: COULEURS[j.t], fillOpacity: .95 });
      m.bindPopup(`<h4>${echapper(j.n)}</h4><p>${echapper(j.a)}${j.a ? '<br>' : ''}${j.cp} ${echapper(j.v)}</p>${j.tel ? `<p><a href="${telHref(j.tel)}">${echapper(j.tel)}</a></p>` : ''}${j.h ? `<p>Accueil${NBSP}: ${echapper(j.h)}</p>` : ''}<p><a href="${j.url}" rel="noopener">Fiche annuaire</a></p>`);
      m.bindTooltip(j.n, { direction: 'top', offset: [0, -6] });
      m.addTo(groupes[j.t]);
      marqueurs[idx] = m;
    });
    document.querySelectorAll<HTMLInputElement>('.legende input').forEach((cb) => cb.addEventListener('change', () => {
      const g = groupes[cb.dataset.type!];
      if (cb.checked) g.addTo(map); else map.removeLayer(g);
    }));
    const om = document.getElementById('outremer');
    if (om) {
      om.innerHTML = `<button type="button" data-metropole>France métropolitaine</button>` + OUTRE_MER.map(([nom], k) => `<button type="button" data-om="${k}">${nom}</button>`).join('');
      om.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
        if (!b) return;
        if (b.dataset.metropole !== undefined) map.fitBounds(METROPOLE);
        else { const [, lat, lon, z] = OUTRE_MER[Number(b.dataset.om)]; map.setView([lat, lon], z); }
      });
    }
  }

  function mettreEnValeur(cadrage: number[]) {
    marqueurs.forEach((m, idx) => {
      const j = donnees.j[idx];
      const actif = selection.includes(idx);
      m.setStyle({ radius: actif ? 11 : j.t === 'TJ' || j.t === 'CA' ? 6 : 4.5, weight: actif ? 3 : 1.2, color: actif ? '#F4D58D' : '#fff' });
      if (actif) m.bringToFront();
    });
    if (cadrage.length) {
      const b = L.latLngBounds(cadrage.map((i) => marqueurs[i].getLatLng()));
      map.fitBounds(b.pad(.6), { maxZoom: 11 });
    }
  }

  champ.disabled = true;
  champ.placeholder = 'Chargement des 35 029 communes…';
  champ.addEventListener('input', () => chercher(champ.value));
  $<HTMLFormElement>('#form-recherche').addEventListener('submit', (e) => {
    e.preventDefault();
    chercher(champ.value, true);
    if (resultat.hidden) { const exactes = communes.filter((c) => c.norm === normaliser(champ.value)); if (exactes.length === 1) afficher(exactes[0]); }
  });
  propositions.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-k]');
    const liste = (propositions as any)._liste as Commune[] | undefined;
    if (b && liste) afficher(liste[Number(b.dataset.k)]);
  });
  resultat.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-voir]');
    if (!b) return;
    const idx = Number(b.dataset.voir);
    const m = marqueurs[idx];
    const j = donnees.j[idx];
    if (!map.hasLayer(groupes[j.t])) { groupes[j.t].addTo(map); const cb = document.querySelector<HTMLInputElement>(`.legende input[data-type=${j.t}]`); if (cb) cb.checked = true; }
    mapEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    map.setView(m.getLatLng(), 14);
    m.openPopup();
  });
  charger().catch(() => { resultat.hidden = false; resultat.innerHTML = '<p class="muet">Le fichier des ressorts n’a pas pu être chargé. Réessayez dans un instant.</p>'; });
</script>
