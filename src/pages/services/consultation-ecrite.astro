---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
const offres = [
  ['Question simple', '100 € TTC', 'Une question précise, une réponse argumentée d’une page, sous 5 jours ouvrés.'],
  ['Consultation', '120 € TTC', 'Une situation exposée avec vos pièces, une note de deux à trois pages, sous 5 jours ouvrés.'],
  ['Consultation approfondie', '349 € TTC', 'Analyse de pièces, stratégie et chiffrage ; un échange téléphonique de 20 min inclus.'],
];
---
<Base title="Consultation d’avocat écrite en ligne dès 100 € | Arnaud Cousin, Rennes" description="Posez votre question par écrit, joignez vos pièces, réglez en ligne : réponse écrite d’un avocat sous 5 jours ouvrés. Trois formules dès 100 € TTC. Secret professionnel garanti." fil={[{ label: 'Services en ligne', href: '/services' }, { label: 'Consultation écrite', href: '/services/consultation-ecrite' }]}>
  <Hero variante="clair" surtitre="Consultation en ligne" titre="Consultez le cabinet par internet" chapo="Sans rendez-vous ni déplacement : question posée immédiatement, réponse écrite que vous conservez, tarif plus avantageux qu’au cabinet. L’équivalent d’une consultation d’orientation d’une heure, sans recherche longue." image="themis" />
  <section class="section">
    <div class="conteneur pile" style="gap: 32px">
      <h2 style="font-size: 28px">1. Choisissez votre consultation</h2>
      <div class="grille">
        {offres.map(([t, p, x]) => <div class="carte"><h3>{t}</h3><p style="font-family: var(--serif); font-size: 30px; color: var(--vert)">{p}</p><p class="muet" style="font-size: 15px">{x}</p></div>)}
      </div>
      <!-- Formulaire traité par /api/consultation.php (phase services) ; paiement Stripe Checkout -->
      <form class="pile" method="post" action="/api/consultation.php" style="gap: 28px; max-width: 820px">
        <div class="pile" style="gap: 14px"><h2 style="font-size: 28px">2. Votre question</h2>
          <label class="champ">Domaine<select name="domaine"><option>Famille, séparation</option><option>Succession, indivision</option><option>Droit du travail</option><option>Procédure, appel</option><option>Autre</option></select></label>
          <label class="champ">Exposez votre situation et votre question<textarea name="question" required style="min-height: 180px" placeholder="Les faits, les dates, ce que vous attendez."></textarea></label>
        </div>
        <div class="pile" style="gap: 14px"><h2 style="font-size: 28px">3. Vos pièces</h2>
          <label class="champ">Documents utiles (PDF, images — 20 Mo au plus)<input type="file" name="pieces[]" multiple accept=".pdf,image/*" style="padding: 10px 14px" /></label>
        </div>
        <div class="pile" style="gap: 14px"><h2 style="font-size: 28px">4. Vos coordonnées et le règlement</h2>
          <div class="grille grille--2" style="gap: 14px"><label class="champ">Nom et prénom<input type="text" name="nom" required autocomplete="name" /></label><label class="champ">Courriel<input type="email" name="email" required autocomplete="email" /></label></div>
          <label style="display: flex; gap: 10px; font-size: 14px; color: var(--muet); align-items: flex-start"><input type="checkbox" name="cgv" required style="margin-top: 4px" /> J’ai lu les <a href="/mentions-legales#cgv" class="lien" style="margin: 0 4px">conditions de la consultation en ligne</a> et je demande l’exécution immédiate de la prestation, renonçant à mon droit de rétractation de quatorze jours.</label>
          <button type="submit" class="btn btn--plein" style="align-self: flex-start">Régler et envoyer</button>
          <p class="muet" style="font-size: 13px">Paiement par carte via un prestataire agréé (le cabinet ne voit jamais votre numéro), ou par virement sur demande. L’avocat peut refuser la consultation : remboursement sous huit jours.</p>
        </div>
      </form>
    </div>
  </section>
</Base>
