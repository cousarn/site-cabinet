---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icone from '../../components/Icone.astro';
import Cta from '../../components/Cta.astro';
import MoteurTribunal from '../../components/MoteurTribunal.astro';
import { cabinet } from '../../data/cabinet';
import themisBandeau from '../../assets/photos/themis-bandeau-1600.webp';

const services = [
  ['calendrier', 'Rendez-vous en ligne', 'Cabinet, visio ou téléphone : choisissez le format et le créneau, c’est confirmé. La première consultation est payante — vous repartez avec un avis — et déduite des honoraires si vous confiez ensuite votre dossier.', '/services/rendez-vous', 'Choisir un créneau'],
  ['ecrit', 'Consultation écrite', 'Posez votre question par écrit, joignez vos pièces, réglez en ligne : une note écrite que vous conservez, sous cinq jours ouvrés. L’équivalent d’une consultation d’orientation d’une heure, sans vous déplacer, moins cher.', '/services/consultation-ecrite', 'Consulter dès 80 €'],
  ['depot', 'Déposer des pièces', 'Clients du cabinet : depuis le lien personnel reçu pour votre dossier, déposez PDF, photos, scans et courriels, de l’ordinateur ou du téléphone. Chiffrés en transit, classés directement dans votre dossier — jamais de pièces jointes en clair.', '/services/depot-pieces', 'Comment ça marche'],
  ['devis', 'Devis divorce par consentement mutuel', 'Sept questions — enfants, prestation compensatoire, biens à partager, état de l’accord — et un ordre de grandeur des honoraires, dès 960 € TTC. L’avocat confirme ou ajuste : ni une promesse ni un plafond.', '/services/devis-divorce', 'Estimer mes honoraires'],
] as const;
---
<Base title="Services en ligne : rendez-vous, consultation écrite | Arnaud Cousin" description="Rendez-vous en ligne, consultation écrite dès 80 €, devis divorce amiable, dépôt sécurisé de pièces : consultez un avocat à Rennes par internet." fil={[{ label: 'Services en ligne', href: '/services' }]}>
  <Hero surtitre="Services en ligne" titre="Consultez le cabinet par internet, comme au cabinet" chapo="Prestations juridiques par internet, autorisées et encadrées par le Règlement intérieur national des avocats. Le cabinet les propose depuis 2015 : pratique, rapide, économique, sécurisé — et la même prestation qu’en rendez-vous." image="couloir" position="60% 40%">
    <div slot="actions" style="display: flex; flex-wrap: wrap; gap: 14px"><a href="/services/consultation-ecrite" class="btn btn--clair">Consultation écrite</a><a href="/services/rendez-vous" class="btn btn--contour-clair">Rendez-vous</a></div>
  </Hero>

  <section class="section">
    <div class="conteneur grille grille--2">
      {services.map(([ic, t, x, h, l]) => (
        <div class="carte"><span class="carte__icone"><Icone nom={ic} /></span><h3>{t}</h3><p class="muet" style="font-size: 15px">{x}</p><a href={h} class="lien" style="margin-top: auto">{l}</a></div>
      ))}
    </div>
    <div class="conteneur" id="tribunal" style="margin-top: 28px">
      <MoteurTribunal niveau="h2" />
    </div>
  </section>

  <section class="section section--nuit decor-parent" id="assistant">
    <div class="decor decor--sombre" aria-hidden="true"><Image src={themisBandeau} alt="" width={1200} loading="lazy" /></div>
    <div class="conteneur deux-colonnes">
      <div class="pile">
        <p class="surtitre">Assistant de pré-entretien</p>
        <h2>Pas sûr de votre situation ? Décrivez-la.</h2>
        <p class="muet">Jour et nuit, une question à la fois, une dizaine de minutes : l’assistant recueille votre situation, repère les dates à signaler et dresse la liste des pièces à réunir. Vos réponses arrivent au cabinet avant le rendez-vous. Il n’est pas avocat et ne donne aucun conseil juridique. Échanges confidentiels, couverts par le secret professionnel.</p>
        <p class="muet" style="font-size: 14px">Prise de message 24h/24 au <a href={`tel:${cabinet.telephoneE164}`}>{cabinet.telephone}</a> pour les urgences.</p>
      </div>
      <!-- Questionnaire guidé : /services/pre-entretien (API /api/pre-entretien.php) -->
      <div class="carte carte--sombre" style="gap: 14px">
        <span style="color: var(--laiton-clair)"><Icone nom="assistant" /></span>
        <h3 style="color: var(--sur-vert)">L’assistant du cabinet</h3>
        <p class="muet" style="font-size: 15px">« Ce qui s’est passé, depuis quand, ce que vous attendez » — puis les pièces à réunir et la prise de rendez-vous dans le format de votre choix.</p>
        <a href="/services/pre-entretien" class="btn btn--clair">Préparer mon rendez-vous</a>
      </div>
    </div>
  </section>

  <section class="section section--ivoire">
    <div class="conteneur grille">
      <div class="pile" style="gap: 10px"><span class="carte__icone"><Icone nom="bouclier" /></span><h3>Le secret professionnel ne s’arrête pas à la porte du cabinet</h3><p class="muet" style="font-size: 15px">PayPal ou carte bancaire sur la page sécurisée de PayPal — le cabinet ne voit jamais votre numéro ; pièces chiffrées, hébergées en France ; aucun traceur publicitaire. Virement et chèque acceptés.</p></div>
      <div class="pile" style="gap: 10px"><span class="carte__icone"><Icone nom="ecrit" /></span><h3>La même prestation qu’en rendez-vous</h3><p class="muet" style="font-size: 15px">C’est l’avocat qui répond, et lui seul. Il peut refuser une consultation : remboursement sous huit jours. Délai de rétractation de quatorze jours, auquel vous pouvez renoncer pour être servi plus vite.</p></div>
      <div class="pile" style="gap: 10px"><span class="carte__icone"><Icone nom="horloge" /></span><h3>De la consultation au dossier</h3><p class="muet" style="font-size: 15px">Si votre question appelle un dossier, le coût de la consultation est déduit des honoraires. Convention signée en ligne, provision réglée en ligne, pièces déposées par votre lien personnel : le dossier démarre sans rendez-vous physique.</p></div>
    </div>
  </section>
  <Cta />
</Base>
