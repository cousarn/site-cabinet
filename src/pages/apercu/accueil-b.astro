---
// Aperçu de composition du bandeau d'accueil (variante B — Débord). Page noindex, hors sitemap, à supprimer une fois le choix fait.
import Base from '../../layouts/Base.astro';
import HeroAccueil from '../../components/HeroAccueil.astro';
import { cabinet, anneesExercice } from '../../data/cabinet';
const n = anneesExercice();
const variantes = [['a', 'Fondu'], ['b', 'Débord'], ['c', 'Bande verte'], ['d', 'Éditorial']];
---
<Base title="Aperçu accueil — Débord | Arnaud Cousin" description="Aperçu de mise en page, non indexé." noindex>
  <HeroAccueil variante="b" />
  <section class="section section--serree" aria-label="Repères" style="border-bottom: 1px solid var(--ligne)">
    <div class="conteneur grille grille--4">
      {[[`${n} ans`, `de barreau, serment prêté en ${cabinet.sermentMois} ${cabinet.sermentAnnee}`], ['Patrimoines complexes', 'entreprises, professions libérales, immobilier'], ['Partenaire des notaires', 'pour débloquer les successions en impasse'], ['Postulation Rennes', 'tribunal judiciaire et cour d’appel, pour les confrères']].map(([k, v]) => (
        <div style="border-top: 1px solid var(--laiton); padding-top: 14px"><div style="font-family: var(--serif); font-size: 28px; color: var(--vert)">{k}</div><div style="font-size: 14px; color: var(--muet)">{v}</div></div>
      ))}
    </div>
  </section>
  <section class="section"><div class="conteneur pile" style="gap: 12px">
    <p class="surtitre">Aperçus de composition — variante B · Débord</p>
    <p class="muet" style="font-size: 15px">Autres variantes : {variantes.filter(([k]) => k !== 'b').map(([k, l], i) => <><a href={`/apercu/accueil-${k}`}>{k.toUpperCase()} · {l}</a>{i < 2 ? ' · ' : ''}</>)}</p>
  </div></section>
</Base>
