---
import Base from '../layouts/Base.astro';
import { cabinet, bookings } from '../data/cabinet';
---
<Base title="Message envoyé | Cabinet Arnaud Cousin" description="Votre demande est bien arrivée au cabinet." noindex>
  <section class="section"><div class="conteneur pile" style="gap: 18px; max-width: 720px; padding-top: 72px; padding-bottom: 72px">
    <p class="surtitre">Merci</p>
    <h1 id="merci-titre">Votre message est bien arrivé.</h1>
    <p class="chapo" id="merci-texte">Vous serez rappelé(e) sous 48 heures ouvrées. Un accusé de réception vous a été adressé par courriel.</p>
    <p id="merci-estimation" class="pile" style="display: none; gap: 6px; border: 1px solid var(--ligne); border-radius: var(--r); padding: 20px 22px; background: var(--ivoire)"></p>
    <div id="merci-creneau-bloc" class="pile" style="display: none; gap: 14px; border: 1px solid var(--ligne); border-radius: var(--r); padding: 22px 24px; background: var(--ivoire)">
      <span class="surtitre">Choisir le créneau</span>
      <a id="merci-creneau" href="/services/rendez-vous" class="btn btn--plein" target="_blank" rel="noopener" data-cabinet={bookings.cabinet} data-visio={bookings.visio} data-telephone={bookings.telephone}>Voir les créneaux libres</a>
      <span class="muet" style="font-size: 14px">Calendrier du cabinet (Microsoft Bookings), dans un nouvel onglet : « Continuer en tant qu’invité », sans compte. Revenez ensuite sur cette page.</span>
    </div>
    <div id="merci-paiement" class="pile" style="display: none; gap: 14px; border: 1px solid var(--laiton-clair); border-radius: var(--r); padding: 22px 24px; background: var(--ivoire)">
      <span class="surtitre">Régler la consultation</span>
      <strong id="merci-montant" style="font-family: var(--serif); font-size: 32px; color: var(--vert)"></strong>
      <a id="merci-payer" href="#" class="btn btn--plein" rel="noopener">Payer par PayPal ou carte bancaire</a>
      <span class="muet" style="font-size: 14px">Page de paiement sécurisée PayPal — carte bancaire acceptée sans compte PayPal. Le cabinet ne voit jamais votre numéro de carte. Vous préférez un virement ? Le RIB est dans le courriel que vous venez de recevoir.</span>
    </div>
    <p class="muet" style="font-size: 14px">Référence : <strong id="merci-ref">—</strong>. Urgence : <a href={`tel:${cabinet.telephoneE164}`}>{cabinet.telephone}</a>, prise de message 24h/24.</p>
    <div style="display: flex; flex-wrap: wrap; gap: 14px"><a id="merci-rdv" href="/services/rendez-vous" class="btn btn--plein" style="display: none">Prendre rendez-vous</a><a id="merci-accueil" href="/" class="btn btn--plein">Retour à l’accueil</a><a href="/fiches" class="btn btn--contour">Lire les fiches pratiques</a></div>
  </div></section>
  <script>
    const q = new URLSearchParams(location.search);
    const objet = q.get('objet');
    const ref = q.get('ref');
    if (ref) document.getElementById('merci-ref')!.textContent = ref;
    const titre = document.getElementById('merci-titre')!;
    const texte = document.getElementById('merci-texte')!;
    const est = document.getElementById('merci-estimation')!;
    if (objet === 'saisine') { titre.textContent = 'Votre saisine est bien reçue.'; texte.textContent = 'Le cabinet vous confirme sa disponibilité et le forfait applicable sous 24 heures ouvrées, avant toute diligence.'; }
    if (objet === 'consultation') {
      titre.textContent = q.get('annule') ? 'Votre demande est enregistrée, le paiement n’a pas été effectué.' : 'Votre demande de consultation est enregistrée.';
      texte.textContent = `Les instructions de règlement (${q.get('prix') ?? ''} € TTC) viennent de vous être adressées par courriel. La réponse écrite de l’avocat vous parvient sous cinq jours ouvrés à compter du règlement.`;
      const payer = q.get('payer');
      if (payer && /^https:\/\/www\.paypal\.com\//.test(payer)) {
        const bloc = document.getElementById('merci-paiement')!;
        (document.getElementById('merci-payer') as HTMLAnchorElement).href = payer;
        document.getElementById('merci-montant')!.textContent = `${q.get('prix') ?? ''} € TTC`;
        bloc.style.display = 'flex';
      }
    }
    const formatRdv = q.get('format') ?? '';
    const montrerCreneau = () => {
      const a = document.getElementById('merci-creneau') as HTMLAnchorElement;
      const lien = /^(cabinet|visio|telephone)$/.test(formatRdv) ? a.dataset[formatRdv] : '';
      if (!lien) return;
      a.href = lien;
      document.getElementById('merci-creneau-bloc')!.style.display = 'flex';
    };
    if (objet === 'rendez-vous') {
      const surPlace = formatRdv === 'cabinet';
      titre.textContent = q.get('annule') ? 'Votre demande est enregistrée, le paiement n’a pas été effectué.' : 'Votre demande est enregistrée : choisissez votre créneau.';
      texte.textContent = surPlace
        ? `Choisissez votre créneau. La consultation (${q.get('prix') ?? ''} € TTC) se règle au cabinet le jour du rendez-vous, ou dès maintenant en ligne. Les liens vous sont aussi adressés par courriel.`
        : `Choisissez votre créneau, puis réglez la consultation (${q.get('prix') ?? ''} € TTC) : le rendez-vous est définitivement retenu à réception du règlement. Les deux liens vous sont aussi adressés par courriel.`;
      montrerCreneau();
      const payerRdv = q.get('payer');
      if (payerRdv && /^https:\/\/www\.paypal\.com\//.test(payerRdv)) {
        (document.getElementById('merci-payer') as HTMLAnchorElement).href = payerRdv;
        document.getElementById('merci-montant')!.textContent = `${q.get('prix') ?? ''} € TTC`;
        document.getElementById('merci-paiement')!.style.display = 'flex';
      }
    }
    if (objet === 'paiement' && q.get('type') === 'rendez-vous') {
      titre.textContent = 'Merci, votre paiement est en cours de confirmation.';
      texte.textContent = 'PayPal vous adresse son reçu par courriel ; le cabinet vous confirme à son tour la réception du règlement, en général dans les minutes qui suivent. Si vous n’avez pas encore choisi votre créneau, faites-le maintenant.';
      montrerCreneau();
    } else if (objet === 'paiement') {
      titre.textContent = 'Merci, votre paiement est en cours de confirmation.';
      texte.textContent = 'PayPal vous adresse son reçu par courriel ; le cabinet vous confirme à son tour la réception du règlement dès que PayPal la lui notifie, en général dans les minutes qui suivent. Le délai de cinq jours ouvrés pour la réponse écrite de l’avocat court à compter de cette confirmation. Référence à conserver pour tout échange avec le cabinet.';
    }
    if (objet === 'pre-entretien') {
      titre.textContent = 'Votre pré-entretien est bien transmis.';
      texte.textContent = 'Le récapitulatif de vos réponses et la liste des pièces à réunir viennent de vous être adressés par courriel. Le cabinet en dispose pour préparer le rendez-vous : il ne vous reste qu’à choisir votre créneau.';
      if (ref) (document.getElementById('merci-rdv') as HTMLAnchorElement).href = `/services/rendez-vous?pre=${encodeURIComponent(ref)}`;
      document.getElementById('merci-rdv')!.style.display = '';
      document.getElementById('merci-accueil')!.className = 'btn btn--contour';
    }
    if (objet === 'devis') {
      titre.textContent = 'Votre estimation vous attend dans votre boîte mail.';
      const n = q.get('estimation');
      const ht = q.get('ht');
      if (n) { est.style.display = 'flex'; est.innerHTML = `<span class="surtitre">Estimation des honoraires du cabinet</span><strong style="font-family: var(--serif); font-size: 36px; color: var(--vert)">${Number(n).toLocaleString('fr-FR')} € TTC</strong><span class="muet" style="font-size: 14px">${ht ? `soit ${Number(ht).toLocaleString('fr-FR')} € HT, TVA 20 % incluse. ` : ''}Ordre de grandeur, ni une promesse ni un plafond — hors avocat de votre conjoint, notaire et huissier. Confirmé ou ajusté par écrit sous 48 h ouvrées.</span>`; texte.textContent = q.get('dcm') === 'incertain' ? 'Vous indiquez être loin d’un accord : le divorce amiable suppose un accord complet ; la négociation est comprise dans l’estimation, et le divorce judiciaire reste possible si elle n’aboutit pas. Le détail vous a été envoyé par courriel.' : 'Le détail ligne par ligne vous a été envoyé par courriel.'; }
    }
  </script>
</Base>
