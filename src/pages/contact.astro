---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { cabinet, acces } from '../data/cabinet';
---
<Base title="Contact et accès — avocat à Rennes, quartier Colombier | Arnaud Cousin" description={`Cabinet Arnaud Cousin, ${cabinet.adresse.rue}, Rennes — métro Colombier à 50 m, parkings, bus, vélo. Rendez-vous au cabinet, en visio ou par téléphone : ${cabinet.telephone}.`} fil={[{ label: 'Contact', href: '/contact' }]}>
  <Hero variante="clair" surtitre="Contact" titre="Parlons de votre situation" chapo="Réception sur rendez-vous uniquement — cabinet, visio ou téléphone. Un courriel ou le formulaire valent mieux qu’un appel impromptu : vous serez rappelé." image="cite">
    <div slot="actions" class="pile" style="gap: 14px">
      <div style="display: flex; flex-wrap: wrap; gap: 14px">
        <a href="/services/rendez-vous" class="btn btn--plein">Prendre rendez-vous</a>
        <a href={`tel:${cabinet.telephoneE164}`} class="btn btn--contour">{cabinet.telephone}</a>
      </div>
      <address class="muet" style="font-size: 15px">
        <strong style="color: var(--encre)">{cabinet.nom}</strong><br />{cabinet.adresse.rue}, {cabinet.adresse.cp} {cabinet.adresse.ville}<br />{cabinet.horaires}<br /><a href={`mailto:${cabinet.email}`} class="lien">{cabinet.email}</a>
      </address>
    </div>
  </Hero>

  <section class="section" id="ecrire">
    <div class="conteneur deux-colonnes" style="align-items: start">
      <div class="pile">
        <h2 style="font-size: 30px">Écrire au cabinet</h2>
        <p class="muet">Vos coordonnées et votre situation dans les grandes lignes ; aucun traitement en dehors de la réponse. Pas de pièces ici : un lien de dépôt sécurisé vous sera adressé si le cabinet prend votre dossier.</p>
        <p class="muet" style="font-size: 14px">Pas besoin de venir : rendez-vous en visio ou par téléphone, pièces déposées en ligne, convention signée à distance — votre dossier se traite d’où vous êtes.</p>
      </div>
      <!-- Formulaire : traité par /api/contact.php (phase services) — champs honeypot et consentement inclus -->
      <form class="pile" method="post" action="/api/contact.php" style="gap: 14px" novalidate>
        <div class="grille grille--2" style="gap: 14px">
          <label class="champ">Nom et prénom<input type="text" name="nom" required autocomplete="name" /></label>
          <label class="champ">Téléphone<input type="tel" name="telephone" autocomplete="tel" /></label>
        </div>
        <label class="champ">Courriel<input type="email" name="email" required autocomplete="email" /></label>
        <label class="champ">Objet
          <select name="objet"><option>Famille, séparation</option><option>Succession, indivision</option><option>Droit du travail</option><option>Procédure, appel</option><option>Notaire / confrère</option><option>Autre</option></select>
        </label>
        <label class="champ">Votre situation, en quelques lignes<textarea name="message" required></textarea></label>
        <label style="display: flex; gap: 10px; font-size: 14px; color: var(--muet); align-items: flex-start"><input type="checkbox" name="consentement" required style="margin-top: 4px" /> J’accepte que ces informations soient utilisées pour me répondre. <a href="/mentions-legales#rgpd" class="lien" style="margin-left: 4px">Confidentialité</a></label>
        <input type="text" name="site" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />
        <button type="submit" class="btn btn--plein" style="align-self: flex-start">Envoyer</button>
      </form>
    </div>
  </section>

  <section class="section section--vert" id="acces">
    <div class="conteneur deux-colonnes" style="align-items: start">
      <figure style="margin: 0" class="pile" >
        <img src="/plan-acces.svg" alt="Plan d’accès : le cabinet rue du Puits Mauger, la station de métro Colombier à 50 mètres, les arrêts de bus Cité judiciaire et Colombier, la Cité judiciaire, le centre Colombia et l’esplanade Charles-de-Gaulle" width="1200" height="900" style="width: 100%; height: auto; border-radius: var(--r); border: 1px solid rgba(244,239,230,.25); background: var(--papier)" loading="lazy" />
        <figcaption class="muet" style="font-size: 13px">Plan dessiné par le cabinet sur fond de données OpenStreetMap. Aucun service cartographique tiers, aucun traceur.</figcaption>
      </figure>
      <div class="pile" style="gap: 18px">
        <p class="surtitre">Venir au cabinet</p>
        <h2>Quartier Colombier, à 50 m du métro</h2>
        <p class="muet">Au cœur de Rennes, à 400 m de la Cité judiciaire. En métro, en bus, en train, en voiture ou à vélo : tout est à moins de dix minutes.</p>
        <div class="grille grille--2" style="gap: 14px">
          <div class="carte carte--sombre" style="padding: 16px 18px; gap: 6px; font-size: 14px"><strong class="surtitre">Métro</strong>{acces.metro.map((m) => <span>Ligne <strong>{m.ligne}</strong> · station <strong>{m.station}</strong> — {m.distance}, {m.temps}</span>)}</div>
          <div class="carte carte--sombre" style="padding: 16px 18px; gap: 6px; font-size: 14px"><strong class="surtitre">Bus &amp; train</strong><span>Arrêts <strong>{acces.bus.arrets[0]}</strong> et <strong>{acces.bus.arrets[1]}</strong> · lignes <strong>{acces.bus.lignes.join(', ')}</strong></span><span>{acces.train}</span></div>
          <div class="carte carte--sombre" style="padding: 16px 18px; gap: 8px; font-size: 14px; grid-column: 1 / -1"><strong class="surtitre">Voiture · parkings publics</strong>
            <ul style="list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 6px 20px">{acces.parkings.map((p) => <li><strong>{p.nom}</strong> ({p.operateur}) · {p.detail} {p.note && <span class="muet">{p.note}</span>}</li>)}</ul>
            <span class="muet">{acces.voirie}</span>
          </div>
          <div class="carte carte--sombre" style="padding: 16px 18px; gap: 6px; font-size: 14px"><strong class="surtitre">Vélo</strong><span>Stations Vélo STAR <strong>{acces.velo.stations.join(', ')}</strong> · {acces.velo.note}</span></div>
          <div class="carte carte--sombre" style="padding: 16px 18px; gap: 6px; font-size: 14px"><strong class="surtitre">Accessibilité</strong><span class="muet">{acces.accessibilite}</span></div>
        </div>
        <a href={`https://www.openstreetmap.org/?mlat=${cabinet.geo.lat}&mlon=${cabinet.geo.lon}#map=17/${cabinet.geo.lat}/${cabinet.geo.lon}`} class="btn btn--contour-clair" style="align-self: flex-start" rel="noopener">Ouvrir dans mon application de plans</a>
      </div>
    </div>
  </section>
</Base>
