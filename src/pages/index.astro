---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Cta from '../components/Cta.astro';
import { cabinet, navigation, anneesExercice, anneesEnLettres } from '../data/cabinet';
import cite from '../assets/photos/cite-judiciaire-bandeau-2400.webp';
import portrait from '../assets/photos/portrait-arnaud-cousin-2000.webp';
import couloirBandeau from '../assets/photos/couloir-bandeau-1672x700.webp';
import parlement from '../assets/photos/parlement-1536.webp';
import parlementBandeau from '../assets/photos/parlement-bandeau-1536x640.webp';
import themis from '../assets/photos/themis-1600.jpg';

const n = anneesExercice();
const fiches = (await getCollection('fiches', (f) => !f.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const icones = ['famille', 'succession', 'travail', 'procedure', 'amiable'] as const;
const listes = [
  ['Divorce amiable ou contentieux', 'Prestation compensatoire, pension alimentaire', 'Liquidation du régime matrimonial', 'Résidence des enfants, autorité parentale'],
  ['Partage judiciaire, licitation', 'Recel, rapport, réduction, testament', 'Assurance-vie, donations', 'Salaire différé agricole'],
  ['Licenciement, inaptitude, prise d’acte', 'Harcèlement, travail dissimulé', 'Rupture conventionnelle, transaction', 'Salariés et employeurs'],
  ['Appels devant la cour de Rennes', 'Référés, incidents, exécution', 'Postulation pour les confrères', 'Renvoi après cassation'],
  ['Médiation judiciaire ou conventionnelle', 'Conciliation, procédure participative', 'Rédaction et homologation des accords', 'Liaison avec le médiateur, l’adversaire, le tribunal'],
];
const leads = [
  ['Vous vous séparez', ' : préserver vos enfants, vos droits et ce que vous avez construit.'],
  ['Succession, indivision ou SCI familiale bloquée', ' : un héritier, un ex-conjoint ou un associé bloque, le notaire attend. En sortir sans y laisser votre part.'],
  ['Licenciement, convocation, rupture proposée', ' : savoir vite ce que vous pouvez accepter, contester, négocier.'],
  ['Un jugement à contester', ', un délai qui court. Ou un confrère qui cherche un relais fiable à Rennes.'],
  ['On vous propose une médiation', ' — ou le juge vous y envoie. Peur du rapport de force, d’un mauvais accord ? Le cabinet vous accompagne à chaque étape.'],
];
---
<Base
  title="Avocat à Rennes — famille, successions, travail | Arnaud Cousin"
  description={`Avocat à Rennes depuis ${n} ans : divorce, successions et indivision, droit du travail, appel, médiation. Rendez-vous en ligne, consultation écrite dès 80 €.`}
  image="/og/cabinet.jpg"
>
  <!-- Hero : portrait en arche sur fond papier, couloir du cabinet en filigrane, nom en lettres géantes -->
  <section class="hero hero--portrait">
    <div class="hp-fond" aria-hidden="true">
      <Image src={couloirBandeau} alt="" widths={[900, 1300, 1672]} sizes="100vw" quality={52} loading="eager" />
    </div>
    <div class="hp-nom" aria-hidden="true"><span class="hp-nom__a">Arnaud</span><span class="hp-nom__b">Cousin</span></div>
    <div class="conteneur hp">
      <div class="hp-texte pile entree">
        <p class="surtitre" style="display: flex; align-items: center; gap: 14px"><span class="filet"></span>Famille · Successions · Travail · Procédure civile</p>
        <h1>Écouter. Analyser.<br />Conseiller. <em>Agir.</em></h1>
        <p class="chapo">Séparation, succession bloquée, licenciement : vous devez savoir vite où vous en êtes, et à quel prix. Négociateur pugnace ou défenseur combatif, avocat à Rennes depuis {anneesEnLettres(n)} ans : appui, soutien et conseil, à des conditions transparentes.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 14px">
          <a href="/services/rendez-vous" class="btn btn--plein btn--grand">Prendre rendez-vous</a>
          <a href="/services/consultation-ecrite" class="btn btn--contour btn--grand">Consultation écrite en ligne</a>
        </div>
        <p class="hp-urgence">Urgence, délai qui expire : <a href={`tel:${cabinet.telephoneE164}`}>{cabinet.telephone}</a> — prise de message 24h/24.</p>
      </div>
      <figure class="hp-portrait">
        <span class="hp-panneau" aria-hidden="true"></span>
        <span class="hp-arche">
          <Image src={portrait} alt="Maître Arnaud Cousin, avocat au Barreau de Rennes" widths={[480, 720, 960, 1200]} sizes="(max-width: 860px) 78vw, 430px" quality={82} loading="eager" fetchpriority="high" />
        </span>
        <span class="hp-pastille hp-pastille--1"><strong>{n} ans</strong> de barreau</span>
        <span class="hp-pastille hp-pastille--2"><span class="hp-point"></span>Rennes · à 400 m de la Cité judiciaire</span>
        <span class="hp-pastille hp-pastille--3"><em>Me</em> Arnaud Cousin<small>Avocat au Barreau de Rennes</small></span>
        <figcaption>Photo : David Ferrière</figcaption>
      </figure>
    </div>
  </section>

  <!-- Repères -->
  <section class="section section--serree" aria-label="Repères" style="border-bottom: 1px solid var(--ligne)">
    <div class="conteneur grille grille--4">
      {[
        [`${n} ans`, `de barreau, serment prêté en ${cabinet.sermentMois} ${cabinet.sermentAnnee}`],
        ['Patrimoines complexes', 'entreprises, professions libérales, immobilier'],
        ['Partenaire des notaires', 'pour débloquer les successions en impasse'],
        ['Postulation Rennes', 'tribunal judiciaire et cour d’appel, pour les confrères'],
      ].map(([k, v]) => (
        <div style="border-top: 1px solid var(--laiton); padding-top: 14px">
          <div style="font-family: var(--serif); font-size: 28px; color: var(--vert)">{k}</div>
          <div style="font-size: 14px; color: var(--muet)">{v}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Domaines -->
  <section class="section" id="domaines">
    <div class="conteneur pile" style="gap: 40px">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 40px">
        <div class="pile" style="max-width: 620px; gap: 14px">
          <p class="surtitre">Domaines d’intervention</p>
          <h2>Contentieux des familles et du patrimoine familial, conflits du travail, droit civil</h2>
          <p class="chapo"><em>Famille et patrimoine</em>, <em>travail</em>, <em>procédure civile et appel</em> : en demande comme en défense, devant les juridictions de Rennes, Saint-Malo, Saint-Brieuc, Nantes et la cour d’appel de Rennes.</p>
        </div>
        <a href="/domaines" class="lien">Tous les domaines</a>
      </div>
      <div class="grille grille--2">
        {navigation.domaines.map((d, i) => (
          <a href={d.href} class="carte carte--lien" style={i === 4 ? 'grid-column: 1 / -1' : undefined}>
            <span class="carte__icone"><Icone nom={icones[i]} /></span>
            <h3>{d.titre}</h3>
            <p style="font-size: 15px"><strong>{leads[i][0]}</strong>{leads[i][1]}</p>
            <ul class="carte__liste">{listes[i].map((l) => <li>{l}</li>)}</ul>
            <span class="lien" style="margin-top: auto">En savoir plus</span>
          </a>
        ))}
      </div>
      <p class="muet" style="font-size: 15px">Également : tutelles et curatelles, voisinage et propriété, recouvrement et contrats, responsabilité civile et accidents.</p>
    </div>
  </section>

  <!-- Pourquoi ce cabinet -->
  <section class="section section--ivoire" id="cabinet">
    <div class="conteneur deux-colonnes" style="align-items: start">
      <div class="pile" style="gap: 20px">
        <figure class="figure" style="max-width: 420px; margin-bottom: 12px">
          <span class="cadre"><Image src={parlementBandeau} alt="La salle des Procureurs du Parlement de Bretagne, siège de la cour d’appel de Rennes" widths={[480, 840, 1200]} sizes="(max-width: 720px) 90vw, 420px" loading="lazy" style="aspect-ratio: 12/5" /></span>
          <figcaption>Parlement de Bretagne, siège de la cour d’appel de Rennes</figcaption>
        </figure>
        <p class="surtitre">Pourquoi ce cabinet</p>
        <h2>Vos intérêts servis par {n} années de défense familiale, patrimoniale et des relations de travail</h2>
        <p class="chapo" style="font-size: 17px">Pas un généraliste : un avocat qui connaît votre problème pour l’avoir plaidé souvent. Droit patrimonial de la famille, contentieux du travail. Rompu aux négociations difficiles, attaché au règlement des conflits lourds.</p>
        <a href="/cabinet" class="lien">Nous connaître</a>
      </div>
      <div class="grille grille--2" style="gap: 28px">
        {[
          ['Une liquidation se gagne sur les chiffres', 'Entreprise, profession libérale, conjoint associé, immobilier : votre dossier se joue sur des chiffres. Avec un réseau de notaires, experts-comptables et fiscalistes, la défense est globale.'],
          ['Vous voulez en finir, pas faire durer', 'L’amiable d’abord, chaque fois qu’il est possible ; le judiciaire, maîtrisé, si l’adversaire refuse. À chaque étape, vous savez où vous en êtes.'],
          ['Le mythe de l’avocat procédurier', 'Chaque convention du cabinet prévoit un honoraire de transaction : l’accord négocié est rémunéré comme le procès gagné. Rien ne pousse à faire durer.'],
          ['La même défense, quels que soient vos moyens', 'Aide juridictionnelle acceptée selon les dossiers, protection juridique toujours vérifiée. La défense est la même pour tous.'],
        ].map(([t, x]) => (
          <div class="pile" style="gap: 10px; border-top: 1px solid var(--laiton); padding-top: 18px">
            <h3>{t}</h3>
            <p class="muet" style="font-size: 15px">{x}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services en ligne -->
  <section class="section section--nuit decor-parent" id="services">
    <div class="decor decor--sombre" aria-hidden="true"><Image src={couloirBandeau} alt="" width={1200} loading="lazy" /></div>
    <div class="conteneur pile" style="gap: 40px">
      <div class="deux-colonnes" style="align-items: end">
        <div class="pile" style="gap: 14px">
          <p class="surtitre">Services en ligne</p>
          <h2>Consulter sans attendre. Et sans vous déplacer.</h2>
          <p class="chapo">Vous travaillez, vous habitez loin, vous voulez une réponse cette semaine : le cabinet consulte par internet depuis 2015. Sans rendez-vous, par écrit, moins cher qu’au cabinet, sous le sceau du secret professionnel.</p>
        </div>
        <a href="/services" class="lien" style="color: #E9D9B5; justify-self: end">Tous les services en ligne</a>
      </div>
      <div class="grille grille--4">
        {[
          ['calendrier', 'Rendez-vous en ligne', 'Choisissez un créneau au cabinet, en visioconférence ou par téléphone. Confirmation et rappel automatiques.', '/services/rendez-vous'],
          ['ecrit', 'Consultation écrite', 'Exposez votre situation, joignez vos pièces, réglez en ligne. Réponse écrite de l’avocat sous 5 jours ouvrés. À partir de 80 € TTC.', '/services/consultation-ecrite'],
          ['depot', 'Déposer des pièces', 'Clients du cabinet : depuis le lien personnel reçu pour votre dossier, déposez PDF, photos et scans, de l’ordinateur ou du téléphone. Classés directement dans votre dossier, sans pièces jointes en clair.', '/services/depot-pieces'],
          ['devis', 'Devis divorce amiable', 'Divorce par consentement mutuel : décrivez votre situation en quelques questions et recevez une estimation d’honoraires, confirmée par l’avocat.', '/services/devis-divorce'],
        ].map(([ic, t, x, h]) => (
          <a href={h} class="carte carte--sombre carte--lien">
            <span style="color: var(--laiton-clair)"><Icone nom={ic as any} /></span>
            <h3>{t}</h3>
            <p class="muet" style="font-size: 15px">{x}</p>
          </a>
        ))}
      </div>
      <p style="border-left: 2px solid var(--laiton-clair); padding-left: 16px; max-width: 760px; color: var(--sur-vert-muet)"><strong style="color: var(--sur-vert)">Pas sûr de votre situation ?</strong> L’assistant de pré-entretien la recueille en une dizaine de minutes, une question à la fois : vos réponses, les dates à signaler et les pièces à réunir arrivent au cabinet avant le rendez-vous — sans conseil juridique. <a href="/services/pre-entretien">Préparer mon rendez-vous →</a></p>
    </div>
  </section>

  <!-- Cabinet connecté -->
  <section class="section" id="connecte" style="border-top: 1px solid var(--ligne)">
    <div class="conteneur pile" style="gap: 36px">
      <div class="pile" style="max-width: 680px; gap: 12px">
        <p class="surtitre">Un cabinet connecté</p>
        <h2>Le droit d’aujourd’hui, les outils d’aujourd’hui.</h2>
        <p class="chapo" style="font-size: 17px">La réactivité ne se promet pas : elle s’organise.</p>
      </div>
      <div class="grille">
        {[
          ['globe', 'Votre dossier, où que vous soyez', 'Visio, signature électronique, dépôt de pièces et paiement en ligne : tout se traite à distance, de Rennes ou d’ailleurs.'],
          ['livre', 'Le droit du jour, pas celui de l’an dernier', 'Textes et jurisprudence suivis au jour le jour, bases de données professionnelles : vos conseils reposent sur le droit d’aujourd’hui.'],
          ['puce', 'La technique au service du conseil, jamais à sa place', 'Dossier dématérialisé, échanges sécurisés avec les juridictions, assistants numériques sous le contrôle de l’avocat : plus de réactivité, plus de qualité.'],
        ].map(([ic, t, x]) => (
          <div class="carte">
            <span class="carte__icone"><Icone nom={ic as any} /></span>
            <h3 style="font-size: 21px">{t}</h3>
            <p class="muet" style="font-size: 15px">{x}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Honoraires -->
  <section class="section section--ivoire" id="honoraires">
    <div class="conteneur deux-colonnes">
      <div class="pile" style="gap: 18px">
        <p class="surtitre">Honoraires</p>
        <h2>La justice n’est pas gratuite</h2>
        <p class="chapo">L’accès au droit n’est jamais gratuit ; son coût doit être juste et transparent. D’où une convention d’honoraires détaillée dès l’ouverture du dossier : mission, mode de calcul, frais de justice.</p>
        <ul class="pile" style="gap: 10px; padding-left: 0; list-style: none; color: var(--muet)">
          <li>— Au temps passé — le plus juste : tout le travail, rien que le travail — ou au forfait lorsque les diligences sont prévisibles</li>
          <li>— Honoraire de résultat dans le respect de la loi, honoraire de transaction pour valoriser l’accord</li>
          <li>— Protection juridique et aide juridictionnelle : on vérifie toujours, même si vous pensez n’y avoir pas droit</li>
        </ul>
        <a href="/honoraires" class="lien">Grille indicative et convention</a>
      </div>
      <figure class="figure" style="max-width: 460px; justify-self: center">
        <span class="cadre"><Image src={themis} alt="Thémis, allégorie de la justice, balance et glaive" widths={[480, 800, 1200]} sizes="(max-width: 720px) 90vw, 460px" loading="lazy" /></span>
        <figcaption>Thémis — la balance pour peser, le glaive pour trancher</figcaption>
      </figure>
    </div>
  </section>

  <!-- Exergue : la Cité judiciaire, à 400 m du cabinet -->
  <section class="exergue" aria-labelledby="exergue-titre">
    <Image src={cite} alt="La Cité judiciaire de Rennes, vue d’en bas, au petit matin" class="exergue__photo" widths={[800, 1200, 1600, 2400]} sizes="100vw" quality={70} loading="lazy" />
    <div class="exergue__voile" aria-hidden="true"></div>
    <div class="conteneur exergue__in">
      <blockquote class="exergue__texte">
        <p id="exergue-titre" class="exergue__citation">Une lumière nouvelle sur votre situation.</p>
        <p class="exergue__suite">Chaque dossier arrive au cabinet avec sa part d’ombre : une succession figée, une séparation qui s’enlise, un licenciement subi. Le travail de l’avocat est d’y voir clair avec vous — un délai respecté, un chiffrage honnête, une audience préparée — jusqu’à ce que la situation se dénoue. À 400 mètres du cabinet, la Cité judiciaire, où siègent le tribunal judiciaire et le conseil de prud’hommes.</p>
        <footer class="exergue__pied"><a href="/cabinet" class="lien" style="color: #E9D9B5">La manière de faire du cabinet</a></footer>
      </blockquote>
    </div>
  </section>

  <!-- Notaires & confrères -->
  <section class="section" id="confreres" style="border-top: 1px solid var(--ligne)">
    <div class="conteneur deux-colonnes">
      <figure class="figure">
        <span class="cadre"><Image src={parlement} alt="Avocats en robe dans la salle des Procureurs du Parlement de Bretagne" widths={[600, 900, 1536]} sizes="(max-width: 720px) 90vw, 560px" loading="lazy" style="aspect-ratio: 3/2" /></span>
      </figure>
      <div class="pile">
        <p class="surtitre">Notaires &amp; confrères</p>
        <h2>Débloquer, sans empiéter.</h2>
        <p class="muet"><strong>Notaires :</strong> un dossier bloqué, un indivisaire qui ne répond plus ? Le cabinet le remet sur la voie de l’accord — avec, si besoin, l’appui du judiciaire : mise en demeure, assignation en partage, désignation de votre étude comme notaire commis — pour revenir ensuite sur le chemin amiable et parachever, entre vos mains, un règlement conventionnel. <strong>Confrères :</strong> postulation et suivi de procédure à Rennes, avec réactivité et célérité, à tarifs connus d’avance. <strong>Conseils :</strong> la séparation d’un dirigeant se règle sur les chiffres, avec vous.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 14px">
          <a href="/notaires-confreres#postulation" class="btn btn--plein">Saisir le cabinet d’une postulation</a>
          <a href="/notaires-confreres#partage" class="btn btn--contour">Débloquer un partage</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Fiches -->
  {fiches.length > 0 && (
    <section class="section section--ivoire" id="actualites">
      <div class="conteneur pile" style="gap: 32px">
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 40px">
          <div class="pile" style="gap: 12px"><p class="surtitre">Fiches &amp; actualités</p><h2>Comprendre avant d’agir</h2></div>
          <a href="/fiches" class="lien">Toutes les fiches</a>
        </div>
        <div class="grille">
          {fiches.map((f) => (
            <a href={`/fiches/${f.id}`} class="carte carte--lien">
              <span class="surtitre">{f.data.type} · {f.data.lecture ?? ''}</span>
              <h3>{f.data.title}</h3>
              <p class="muet" style="font-size: 15px">{f.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Cta />
</Base>

<style>
  /* ---- Hero portrait ------------------------------------------------------------------
     Fond papier ; le couloir du cabinet passe en filigrane (gris, 12 %), masqué vers la gauche pour laisser le
     texte respirer ; le nom en lettres géantes traverse la composition, « Cousin » passant en transparence
     devant le bas du portrait. Le portrait n'est pas retouché : seulement cadré dans une arche. */
  .hero--portrait { background: var(--papier); color: var(--encre); border-top: 1px solid var(--ligne-douce); }
  .hero--portrait::before { content: ''; position: absolute; inset: 0; background: radial-gradient(55% 70% at 78% 30%, rgba(202, 171, 127, .30), transparent 70%); pointer-events: none; }
  .hp-fond { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .hp-fond img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 50%; opacity: .12; filter: grayscale(.6) contrast(1.08); mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 42%, #000 100%), linear-gradient(0deg, transparent 0%, #000 30%); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent 0%, #000 42%, #000 100%), linear-gradient(0deg, transparent 0%, #000 30%); mask-composite: intersect; }
  .hp-nom { position: absolute; inset: 0; pointer-events: none; font-family: var(--serif); font-weight: 300; letter-spacing: -.03em; line-height: .82; color: var(--laiton); }
  .hp-nom span { position: absolute; right: max(24px, calc((100% - var(--conteneur)) / 2)); font-size: clamp(96px, 13.5vw, 210px); white-space: nowrap; }
  .hp-nom__a { top: 34px; opacity: .12; }
  .hp-nom__b { bottom: 18px; opacity: .17; font-style: italic; }
  .hp { position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(300px, .95fr); gap: 48px; align-items: center; padding-top: 72px; padding-bottom: 84px; }
  .hp-texte { gap: 26px; max-width: 600px; }
  .hero--portrait h1 { color: var(--vert); font-size: clamp(42px, 5.4vw, 70px); }
  .hero--portrait h1 em { font-style: italic; color: var(--laiton-sombre); }
  .hero--portrait .chapo { color: var(--muet); font-size: 19px; }
  .hp-urgence { font-size: 14px; color: var(--muet); }
  .hp-urgence a { color: var(--vert); font-weight: 600; text-decoration: none; }

  .hp-portrait { position: relative; z-index: 2; margin: 0; justify-self: end; width: min(100%, 430px); }
  .hp-arche { position: relative; z-index: 2; display: block; aspect-ratio: 4 / 5; border-radius: 999px 999px 22px 22px; overflow: hidden; box-shadow: 0 30px 60px -28px rgba(17, 53, 47, .45); }
  .hp-arche img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 24%; display: block; }
  .hp-panneau { position: absolute; z-index: 1; top: 0; left: 0; right: 0; aspect-ratio: 4 / 5; transform: translate(28px, 28px); border-radius: 999px 999px 22px 22px; background: rgba(17, 53, 47, .9); }
  .hp-panneau::after { content: ''; position: absolute; inset: -16px; border: 1px solid var(--laiton); border-radius: 999px 999px 30px 30px; opacity: .55; }
  .hp-pastille { position: absolute; z-index: 4; display: inline-flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 999px; background: rgba(252, 250, 245, .78); border: 1px solid rgba(154, 123, 79, .35); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: 0 14px 30px -16px rgba(17, 53, 47, .35); font-size: 14px; color: var(--vert); white-space: nowrap; }
  .hp-pastille strong { font-family: var(--serif); font-weight: 500; font-size: 22px; line-height: 1; color: var(--vert); }
  .hp-pastille--1 { left: -54px; top: 31%; }
  .hp-pastille--2 { right: -70px; top: 56%; }
  .hp-pastille--3 { left: -26px; bottom: 9%; flex-direction: column; align-items: flex-start; gap: 2px; padding: 12px 18px; font-family: var(--serif); font-size: 20px; border-radius: 14px; }
  .hp-pastille--3 em { font-style: italic; color: var(--laiton-sombre); margin-right: 6px; }
  .hp-pastille--3 small { font-family: var(--sans); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--laiton-sombre); }
