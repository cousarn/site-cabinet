# Cabinet Arnaud Cousin — configuration Apache (OVH mutualisé)
# Objectifs : HTTPS + domaine unique (sans www), URLs sans extension,
# redirections 301 depuis l'ancien site TOWeb, en-têtes de sécurité, cache.

Options -Indexes -MultiViews
DirectorySlash Off
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. HTTPS obligatoire et domaine canonique sans www
  #    (derrière le proxy OVH, HTTPS se lit aussi dans X-Forwarded-Proto ; le port est retiré de l'hôte)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^(?:www\.)?([^:]+) [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.([^:]+) [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 2. Anciennes adresses TOWeb → nouvelles pages (301 permanentes)
  #    Garde REDIRECT_STATUS : ne jamais rejouer ces règles après la réécriture interne /contact → contact.html
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^nous-connaitre\.html$ https://%{HTTP_HOST}/cabinet [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^domaines-dintervention\.html$ https://%{HTTP_HOST}/domaines [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^tarifs-et-couts-justesse-et-transparence\.html$ https://%{HTTP_HOST}/honoraires [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^consultez-le-cabinet-par-internet\.html$ https://%{HTTP_HOST}/services/consultation-ecrite [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^consultez-le-cabinet-par-internet-consultation-en-ligne\.html$ https://%{HTTP_HOST}/services/consultation-ecrite [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(droit-de-la-famille|divorce|famille)\.html$ https://%{HTTP_HOST}/domaines/separation-divorce [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(successions|succession|indivision)\.html$ https://%{HTTP_HOST}/domaines/successions [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(droit-du-travail|travail)\.html$ https://%{HTTP_HOST}/domaines/droit-du-travail [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(procedure|appel|procedure-appel)\.html$ https://%{HTTP_HOST}/domaines/procedure-appel [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^_checkout\.html$ https://%{HTTP_HOST}/services/consultation-ecrite [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^infos-pratiques\.html$ https://%{HTTP_HOST}/contact [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^contact\.html$ https://%{HTTP_HOST}/contact [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^mentions-legales\.html$ https://%{HTTP_HOST}/mentions-legales [R=301,L]

  # 2 bis. Lien personnel de dépôt de pièces : /depot/<jeton> → page statique (le jeton est lu par le script de la page)
  RewriteRule ^depot/[A-Za-z0-9_-]{20,}/?$ /services/depot-pieces.html [L]

  # 3. Pas de barre finale (sauf racine), pas d'extension visible
  #    Les redirections externes ne s'appliquent qu'à la requête d'origine (REDIRECT_STATUS vide),
  #    jamais après la réécriture interne vers le .html ni pour la page d'erreur 404.
  #    Cas des pages qui ont un dossier homonyme de sous-pages (/domaines + /domaines/*) :
  #    DirectorySlash est coupé pour qu'Apache n'ajoute pas lui-même la barre finale.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Ne pas annoncer la version de PHP.
  Header always unset X-Powered-By
  Header unset X-Powered-By
  # Préproduction : jamais indexée, même si une page oublie sa balise noindex.
  <If "%{HTTP_HOST} == 'preprod.arnaudcousin-avocat.fr'">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  # CSP : à élargir à la mise en place de Bookings / Stripe (frame-src, script-src)
  # img-src data.geopf.fr et tile.openstreetmap.org : fonds de carte (IGN ; OSM pour le Pacifique) de la page /competence-territoriale
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://data.geopf.fr https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; frame-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'"
  # Les fichiers générés par Astro portent un hash : cache long
  <FilesMatch "\.(css|js|woff2|webp|avif|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>
